import { Button, LineEdit, ComboBox, CheckBox, ProgressIndicator, Palette } from "std-widgets.slint";
import { Theme } from "theme.slint";

export component SettingsDialog inherits Rectangle {
    init => {
        Palette.color-scheme = Theme.is_dark ? ColorScheme.dark : ColorScheme.light;
    }

    x: 0px;
    y: 0px;
    width: 100%;
    height: 100%;
    background: Theme.overlay;

    // Config Properties
    in-out property <string> vault_path: "";
    in-out property <bool> use_multithreading: true;
    in-out property <string> theme: "dark";
    in property <[string]> theme_options: ["dark", "blue", "light"];
    in-out property <string> global_hotkey: "Shift+Space";
    in-out property <bool> minimize_to_tray: true;
    in-out property <bool> is_recording_hotkey: false;
    in property <bool> is_vault_locked: true;

    // Password Change Properties
    in-out property <string> current_password: "";
    in-out property <string> new_password: "";
    in-out property <string> confirm_password: "";
    in property <string> password_change_status: "";
    in property <bool> password_change_success: false;
    in property <bool> is_reencrypting: false;
    in property <float> reencrypt_progress: 0.0;

    // Keyfile Management Properties
    in-out property <string> keyfile_current_password: "";
    in-out property <string> new_keyfile_path: "";
    in-out property <bool> remove_keyfile: false;
    in property <string> keyfile_status: "";
    in property <bool> keyfile_success: false;
    in property <bool> is_keyfile_reencrypting: false;
    in property <float> keyfile_reencrypt_progress: 0.0;

    // Callbacks
    callback browse_path_clicked();
    callback save_settings(string, bool, string, string, bool);
    callback change_password(string, string, string);
    callback browse_new_keyfile();
    callback update_keyfile(string, string, bool);
    callback theme_changed(string);
    callback record_key_event(string, bool, bool, bool, bool) -> string;
    callback close_clicked();

    TouchArea {}

    Rectangle {
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        width: 700px;
        height: content_layout.preferred-height;
        background: Theme.bg_surface;
        border-radius: 12px;
        border-width: 1px;
        border-color: Theme.border_active;
        clip: true;

        content_layout := VerticalLayout {
            padding-top: 16px;
            padding-bottom: 16px;
            padding-left: 24px;
            padding-right: 24px;
            spacing: 12px;
            alignment: start;

            // Dialog Header Bar
            HorizontalLayout {
                HorizontalLayout {
                    spacing: 8px;
                    alignment: start;
                    cross-axis-alignment: center;
                    horizontal-stretch: 1;

                    Image {
                        source: @image-url("../assets/icons/settings.svg");
                        width: 18px;
                        height: 18px;
                        colorize: Theme.text_primary;
                    }

                    Text {
                        text: "Settings";
                        font-size: 18px;
                        font-weight: 700;
                        color: Theme.text_primary;
                        vertical-alignment: center;
                    }
                }

                Rectangle {
                    width: 28px;
                    height: 28px;
                    border-radius: 6px;
                    background: close_touch.has-hover ? Theme.hover : Colors.transparent;

                    close_touch := TouchArea {
                        mouse-cursor: pointer;
                        clicked => {
                            root.close_clicked();
                        }
                    }

                    Image {
                        source: @image-url("../assets/icons/x.svg");
                        width: 14px;
                        height: 14px;
                        colorize: close_touch.has-hover ? Theme.text_primary : Theme.text_secondary;
                        x: (parent.width - self.width) / 2;
                        y: (parent.height - self.height) / 2;
                    }
                }
            }

            // Section 1: Vault Location
            VerticalLayout {
                spacing: 6px;

                Text {
                    text: "Vault Directory";
                    font-size: 12px;
                    font-weight: 600;
                    color: Theme.text_secondary;
                }

                HorizontalLayout {
                    spacing: 8px;

                    LineEdit {
                        text: root.vault_path;
                        font-size: 13px;
                        enabled: false;
                        horizontal-stretch: 1;
                    }

                    Button {
                        text: "Browse...";
                        clicked => {
                            root.browse_path_clicked();
                        }
                    }
                }
            }

            // Section 2: Preferences (Decryption, Tray, Hotkey & Theme)
            VerticalLayout {
                spacing: 10px;

                CheckBox {
                    text: "Use multi-core decryption";
                    checked <=> root.use_multithreading;
                }

                CheckBox {
                    text: "Minimize to tray icon";
                    checked <=> root.minimize_to_tray;
                }

                HorizontalLayout {
                    spacing: 8px;
                    cross-axis-alignment: center;

                    Text {
                        text: "Global Hotkey:";
                        font-size: 13px;
                        color: Theme.text_primary;
                        vertical-alignment: center;
                    }

                    record_scope := FocusScope {
                        horizontal-stretch: 1;
                        height: 32px;

                        key-pressed(event) => {
                            if root.is_recording_hotkey {
                                if event.text == Key.Escape {
                                    root.is_recording_hotkey = false;
                                    return accept;
                                }
                                let detected = root.record_key_event(event.text, event.modifiers.control, event.modifiers.alt, event.modifiers.shift, event.modifiers.meta);
                                if detected != "" {
                                    root.global_hotkey = detected;
                                    root.is_recording_hotkey = false;
                                }
                                return accept;
                            }
                            reject
                        }

                        Rectangle {
                            width: 100%;
                            height: 100%;
                            background: root.is_recording_hotkey ? Theme.bg_active : Theme.bg_secondary;
                            border-radius: 6px;
                            border-width: 1.5px;
                            border-color: root.is_recording_hotkey ? Theme.accent : Theme.border;

                            HorizontalLayout {
                                padding-left: 10px;
                                padding-right: 8px;
                                spacing: 8px;
                                cross-axis-alignment: center;

                                Image {
                                    source: @image-url("../assets/icons/search.svg");
                                    width: 14px;
                                    height: 14px;
                                    colorize: root.is_recording_hotkey ? Theme.accent : Theme.text_secondary;
                                }

                                Text {
                                    text: root.is_recording_hotkey ? "Press shortcut on keyboard (e.g. Shift+Space)..." : root.global_hotkey;
                                    font-size: 13px;
                                    font-weight: root.is_recording_hotkey ? 600 : 700;
                                    color: root.is_recording_hotkey ? Theme.accent : Theme.text_primary;
                                    horizontal-stretch: 1;
                                    vertical-alignment: center;
                                }

                                if !root.is_recording_hotkey : Rectangle {
                                    width: 65px;
                                    height: 22px;
                                    border-radius: 4px;
                                    background: Theme.hover;

                                    Text {
                                        text: "Record";
                                        font-size: 11px;
                                        font-weight: 600;
                                        color: Theme.text_primary;
                                        horizontal-alignment: center;
                                        vertical-alignment: center;
                                    }
                                }

                                if root.is_recording_hotkey : Rectangle {
                                    width: 60px;
                                    height: 22px;
                                    border-radius: 4px;
                                    background: Theme.danger;

                                    Text {
                                        text: "Cancel";
                                        font-size: 11px;
                                        font-weight: 600;
                                        color: Theme.danger_text;
                                        horizontal-alignment: center;
                                        vertical-alignment: center;
                                    }
                                }
                            }

                            TouchArea {
                                mouse-cursor: pointer;
                                clicked => {
                                    root.is_recording_hotkey = !root.is_recording_hotkey;
                                    if root.is_recording_hotkey {
                                        record_scope.focus();
                                    }
                                }
                            }
                        }
                    }

                    Button {
                        text: "Reset";
                        clicked => {
                            root.global_hotkey = "Shift+Space";
                            root.is_recording_hotkey = false;
                        }
                    }
                }

                HorizontalLayout {
                    spacing: 12px;
                    alignment: start;

                    Text {
                        text: "Theme:";
                        font-size: 13px;
                        color: Theme.text_primary;
                        vertical-alignment: center;
                    }

                    ComboBox {
                        width: 140px;
                        height: 28px;
                        model: root.theme_options;
                        current-value: root.theme;
                        selected(val) => {
                            root.theme = val;
                            Theme.theme = val;
                            Theme.is_dark = (val != "light");
                            Palette.color-scheme = (val != "light") ? ColorScheme.dark : ColorScheme.light;
                            root.theme_changed(val);
                        }
                    }
                }
            }

            // Section 3: Password Change Box
            Rectangle {
                background: Theme.bg_secondary;
                border-radius: 8px;
                border-width: 1px;
                border-color: Theme.border;
                opacity: root.is_vault_locked ? 0.55 : 1.0;

                VerticalLayout {
                    padding: 14px;
                    spacing: 10px;

                    HorizontalLayout {
                        spacing: 6px;
                        alignment: start;
                        cross-axis-alignment: center;

                        Image {
                            source: @image-url("../assets/icons/lock.svg");
                            width: 14px;
                            height: 14px;
                            colorize: Theme.text_primary;
                        }

                        Text {
                            text: "Change Master Password";
                            font-size: 13px;
                            font-weight: 700;
                            color: Theme.text_primary;
                            vertical-alignment: center;
                        }
                    }

                    if root.is_vault_locked : Text {
                        text: "🔒 Vault is locked. Unlock the vault to change the master password.";
                        font-size: 11px;
                        font-weight: 600;
                        color: Theme.accent;
                        wrap: word-wrap;
                    }

                    if !root.is_vault_locked : Text {
                        text: "Changing your master password will re-encrypt all notes with the new password.";
                        font-size: 11px;
                        color: Theme.text_secondary;
                        wrap: word-wrap;
                    }

                    HorizontalLayout {
                        spacing: 8px;

                        VerticalLayout {
                            horizontal-stretch: 1;
                            spacing: 3px;

                            Text {
                                text: "Current Password";
                                font-size: 11px;
                                color: Theme.text_secondary;
                            }

                            cur_pwd := LineEdit {
                                text <=> root.current_password;
                                input-type: InputType.password;
                                font-size: 12px;
                                placeholder-text: root.is_vault_locked ? "Vault locked" : "Current password...";
                                enabled: !root.is_vault_locked && !root.is_reencrypting;
                            }
                        }

                        VerticalLayout {
                            horizontal-stretch: 1;
                            spacing: 3px;

                            Text {
                                text: "New Password";
                                font-size: 11px;
                                color: Theme.text_secondary;
                            }

                            new_pwd := LineEdit {
                                text <=> root.new_password;
                                input-type: InputType.password;
                                font-size: 12px;
                                placeholder-text: root.is_vault_locked ? "Vault locked" : "New password...";
                                enabled: !root.is_vault_locked && !root.is_reencrypting;
                            }
                        }

                        VerticalLayout {
                            horizontal-stretch: 1;
                            spacing: 3px;

                            Text {
                                text: "Confirm New";
                                font-size: 11px;
                                color: Theme.text_secondary;
                            }

                            confirm_pwd := LineEdit {
                                text <=> root.confirm_password;
                                input-type: InputType.password;
                                font-size: 12px;
                                placeholder-text: root.is_vault_locked ? "Vault locked" : "Confirm new...";
                                enabled: !root.is_vault_locked && !root.is_reencrypting;
                            }
                        }
                    }

                    HorizontalLayout {
                        spacing: 10px;
                        alignment: start;

                        Button {
                            text: "Change Password";
                            enabled: !root.is_vault_locked && !root.is_reencrypting && root.current_password != "" && root.new_password != "" && root.confirm_password != "";
                            clicked => {
                                root.change_password(root.current_password, root.new_password, root.confirm_password);
                            }
                        }

                        if root.password_change_status != "" : Text {
                            text: root.password_change_status;
                            font-size: 11px;
                            color: root.password_change_success ? Theme.success : Theme.danger;
                            vertical-alignment: center;
                            horizontal-stretch: 1;
                            overflow: elide;
                        }
                    }

                    if root.is_reencrypting : VerticalLayout {
                        spacing: 4px;

                        ProgressIndicator {
                            progress: root.reencrypt_progress;
                        }
                    }
                }
            }

            // Section 4: Manage Keyfile Box
            Rectangle {
                background: Theme.bg_secondary;
                border-radius: 8px;
                border-width: 1px;
                border-color: Theme.border;
                opacity: root.is_vault_locked ? 0.55 : 1.0;

                VerticalLayout {
                    padding: 14px;
                    spacing: 10px;

                    HorizontalLayout {
                        spacing: 6px;
                        alignment: start;
                        cross-axis-alignment: center;

                        Text {
                            text: "🔑 Manage Keyfile";
                            font-size: 13px;
                            font-weight: 700;
                            color: Theme.text_primary;
                            vertical-alignment: center;
                        }
                    }

                    if root.is_vault_locked : Text {
                        text: "🔒 Vault is locked. Unlock the vault to manage the keyfile.";
                        font-size: 11px;
                        font-weight: 600;
                        color: Theme.accent;
                        wrap: word-wrap;
                    }

                    if !root.is_vault_locked : Text {
                        text: "Adding or removing a keyfile will re-encrypt all notes. Keep your keyfile safe!";
                        font-size: 11px;
                        color: Theme.text_secondary;
                        wrap: word-wrap;
                    }

                    HorizontalLayout {
                        spacing: 8px;
                        cross-axis-alignment: end;

                        VerticalLayout {
                            horizontal-stretch: 1;
                            spacing: 3px;

                            Text {
                                text: "Current Password";
                                font-size: 11px;
                                color: Theme.text_secondary;
                            }

                            LineEdit {
                                text <=> root.keyfile_current_password;
                                input-type: InputType.password;
                                font-size: 12px;
                                placeholder-text: root.is_vault_locked ? "Vault locked" : "Current password...";
                                enabled: !root.is_vault_locked && !root.is_keyfile_reencrypting;
                            }
                        }

                        VerticalLayout {
                            horizontal-stretch: 2;
                            spacing: 3px;

                            Text {
                                text: "New Keyfile";
                                font-size: 11px;
                                color: Theme.text_secondary;
                            }

                            HorizontalLayout {
                                spacing: 4px;

                                LineEdit {
                                    text: root.new_keyfile_path;
                                    read-only: true;
                                    font-size: 12px;
                                    placeholder-text: root.is_vault_locked ? "Vault locked" : (root.remove_keyfile ? "Keyfile will be removed" : "Select keyfile...");
                                    enabled: !root.is_vault_locked && !root.remove_keyfile && !root.is_keyfile_reencrypting;
                                    horizontal-stretch: 1;
                                }

                                Button {
                                    text: "Browse...";
                                    enabled: !root.is_vault_locked && !root.remove_keyfile && !root.is_keyfile_reencrypting;
                                    clicked => {
                                        root.browse_new_keyfile();
                                    }
                                }
                            }
                        }

                        VerticalLayout {
                            alignment: end;
                            padding-bottom: 6px;

                            CheckBox {
                                text: "Remove Keyfile";
                                checked <=> root.remove_keyfile;
                                enabled: !root.is_vault_locked && !root.is_keyfile_reencrypting;
                            }
                        }
                    }

                    HorizontalLayout {
                        spacing: 10px;
                        alignment: start;

                        Button {
                            text: "Update Keyfile";
                            enabled: !root.is_vault_locked &&
                                     !root.is_keyfile_reencrypting &&
                                     root.keyfile_current_password != "" &&
                                     ((root.new_keyfile_path != "" && !root.remove_keyfile) || root.remove_keyfile);
                            clicked => {
                                root.update_keyfile(root.keyfile_current_password, root.new_keyfile_path, root.remove_keyfile);
                            }
                        }

                        if root.keyfile_status != "" : Text {
                            text: root.keyfile_status;
                            font-size: 11px;
                            color: root.keyfile_success ? Theme.success : Theme.danger;
                            vertical-alignment: center;
                            horizontal-stretch: 1;
                            overflow: elide;
                        }
                    }

                    if root.is_keyfile_reencrypting : VerticalLayout {
                        spacing: 4px;

                        ProgressIndicator {
                            progress: root.keyfile_reencrypt_progress;
                        }
                    }
                }
            }


            // Footer Action Buttons
            HorizontalLayout {
                spacing: 10px;
                alignment: end;

                Button {
                    text: "Close";
                    clicked => {
                        root.close_clicked();
                    }
                }

                Button {
                    text: "Save Settings";
                    primary: true;
                    clicked => {
                        root.save_settings(root.vault_path, root.use_multithreading, root.theme, root.global_hotkey, root.minimize_to_tray);
                    }
                }
            }
        }
    }
}
