import { LineEdit, Palette } from "std-widgets.slint";
import { Theme } from "theme.slint";
import { AppButton, ModalHeader } from "components.slint";

export component UnlockWindow inherits Window {
    title: "NoteVault - Unlock Vault";
    icon: @image-url("../assets/icons/logo.svg");
    no-frame: true;
    width: Theme.modal_width_md;
    preferred-width: Theme.modal_width_md;
    height: content_layout.preferred-height;
    preferred-height: content_layout.preferred-height;
    background: Colors.transparent;
    default-font-family: "Segoe UI, Inter, sans-serif";

    in-out property <string> password: "";
    in-out property <string> error_message: "";
    in-out property <bool> show_keyfile_browse: false;
    in-out property <bool> is_loading: false;
    out property <length> requested_height: content_layout.preferred-height;

    callback unlock_requested(string);
    callback browse_keyfile_requested();
    callback close_requested();

    public function focus_password() {
        fs.focus();
        pwd_input.focus();
    }

    public function clear_fields() {
        root.password = "";
        root.error_message = "";
        root.is_loading = false;
    }

    init => {
        Palette.color-scheme = Theme.is_dark ? ColorScheme.dark : ColorScheme.light;
        pwd_input.focus();
    }

    property <bool> is_dark: Theme.is_dark;
    changed is_dark => {
        Palette.color-scheme = Theme.is_dark ? ColorScheme.dark : ColorScheme.light;
    }

    fs := FocusScope {
        width: 100%;
        height: 100%;
        capture-key-pressed(event) => {
            if event.text == Key.Escape {
                root.clear_fields();
                root.close_requested();
                return accept;
            }
            reject
        }
        key-pressed(event) => {
            if event.text == Key.Escape {
                root.clear_fields();
                root.close_requested();
                return accept;
            }
            reject
        }

        Rectangle {
            width: 100%;
            height: content_layout.preferred-height;
            background: Theme.bg_surface;
            border-radius: Theme.radius_lg;
            border-width: 1px;
            border-color: Theme.border_active;
            clip: true;

            content_layout := VerticalLayout {
                padding-top: Theme.modal_pad_y;
                padding-bottom: Theme.modal_pad_y;
                padding-left: Theme.modal_pad_x;
                padding-right: Theme.modal_pad_x;
                spacing: Theme.modal_spacing;
                alignment: start;

                VerticalLayout {
                    spacing: 6px;

                    ModalHeader {
                        title: "Unlock Secure Vault";
                        show_icon: true;
                        icon: @image-url("../assets/icons/lock.svg");
                        icon_color: Theme.accent;
                        close_clicked => {
                            root.clear_fields();
                            root.close_requested();
                        }
                    }

                    Text {
                        text: "Enter your master passphrase to unlock and search notes.";
                        font-size: Theme.font_sm;
                        color: Theme.text_secondary;
                        horizontal-alignment: left;
                        wrap: word-wrap;
                    }
                }

                pwd_input := LineEdit {
                    height: Theme.input_height;
                    text <=> root.password;
                    input-type: InputType.password;
                    placeholder-text: "Master Vault Password...";
                    font-size: Theme.font_md;
                    enabled: !root.is_loading;
                    accepted => {
                        if !root.is_loading {
                            root.unlock_requested(root.password);
                        }
                    }
                }

                if root.error_message != "" : Text {
                    text: root.error_message;
                    font-size: Theme.font_sm;
                    color: Theme.danger;
                    horizontal-alignment: left;
                    wrap: word-wrap;
                }

                HorizontalLayout {
                    spacing: Theme.space_sm;
                    alignment: root.show_keyfile_browse ? space-between : end;
                    cross-axis-alignment: center;

                    if root.show_keyfile_browse : AppButton {
                        text: "Browse Keyfile...";
                        variant: "secondary";
                        enabled: !root.is_loading;
                        clicked => {
                            root.browse_keyfile_requested();
                        }
                    }

                    AppButton {
                        text: root.is_loading ? "Unlocking..." : "Unlock Vault";
                        variant: "primary";
                        enabled: !root.is_loading;
                        horizontal-stretch: root.show_keyfile_browse ? 0 : 1;
                        clicked => {
                            root.unlock_requested(root.password);
                        }
                    }
                }
            }
        }
    }
}
