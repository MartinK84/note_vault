import { Palette } from "std-widgets.slint";

export global Theme {
    in-out property <bool> is_dark: true;

    changed is_dark => {
        Palette.color-scheme = is_dark ? ColorScheme.dark : ColorScheme.light;
    }

    // Palette tokens
    out property <color> bg_main: is_dark ? #181825 : #f8f9fa;
    out property <color> bg_surface: is_dark ? #1e1e2e : #ffffff;
    out property <color> bg_secondary: is_dark ? #181825 : #f1f3f5;
    out property <color> bg_active: is_dark ? #313244 : #dee2e6;
    out property <color> border: is_dark ? #313244 : #dee2e6;
    out property <color> border_active: is_dark ? #45475a : #adb5bd;
    out property <color> text_primary: is_dark ? #cdd6f4 : #1a1a24;
    out property <color> text_secondary: is_dark ? #a6adc8 : #495057;
    out property <color> text_muted: is_dark ? #9399b2 : #6c757d;
    out property <color> accent: is_dark ? #89b4fa : #0d6efd;
    out property <color> accent_hover: is_dark ? #b4befe : #0b5ed7;
    out property <color> accent_text: is_dark ? #11111b : #ffffff;
    out property <color> danger: is_dark ? #f38ba8 : #dc3545;
    out property <color> danger_hover: is_dark ? #f5a0b8 : #bb2d3b;
    out property <color> danger_text: is_dark ? #11111b : #ffffff;
    out property <color> success: is_dark ? #a6e3a1 : #198754;
    out property <color> hover: is_dark ? #313244 : #e9ecef;
    out property <color> overlay: is_dark ? #000000bd : #00000040;

    // Backward-compatible aliases
    out property <color> background: bg_main;
    out property <color> surface: bg_surface;
    out property <color> surface_secondary: bg_secondary;
    out property <color> surface_hover: hover;
    out property <color> surface_active: bg_active;
    out property <color> border_strong: border_active;
    out property <color> text: text_primary;
    out property <color> primary: accent;
    out property <color> primary_hover: accent_hover;
    out property <color> primary_text: accent_text;
    out property <color> modal_scrim: overlay;
}
