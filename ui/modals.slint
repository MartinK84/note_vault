// ==========================================
// MODAL: ATTACHMENT PREVIEW
// ==========================================
export component AttachmentPreviewModal inherits Rectangle {
    x: 0px;
    y: 0px;
    width: 100%;
    height: 100%;
    background: Theme.overlay;
    z: 2000;
    forward-focus: modal_focus;

    in property <string> attachment_id: "";
    in property <string> file_name: "";
    in property <string> file_size_formatted: "";
    in property <string> created_at_formatted: "";
    in property <bool> is_image: false;
    in property <image> preview_image;
    in property <bool> is_text: false;
    in property <string> preview_text: "";
    in property <string> preview_error: "";

    callback close();
    callback download(string);

    init => {
        modal_focus.focus();
    }

    modal_focus := FocusScope {
        width: 100%;
        height: 100%;

        capture-key-pressed(event) => {
            if event.text == Key.Escape {
                root.close();
                return accept;
            }
            reject
        }

        key-pressed(event) => {
            if event.text == Key.Escape {
                root.close();
                return accept;
            }
            reject
        }

        TouchArea {
            clicked => {
                root.close();
            }
        }

        modal_card := Rectangle {
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
            width: Math.min(parent.width - 64px, 860px);
            height: Math.min(parent.height - 64px, 680px);
            background: Theme.bg_surface;
            border-radius: Theme.radius_lg;
            border-width: 1px;
            border-color: Theme.border_active;
            drop-shadow-blur: 24px;
            drop-shadow-color: #00000040;
            drop-shadow-offset-y: 8px;
            clip: true;

            TouchArea {
                clicked => {
                    modal_focus.focus();
                }
            }

            VerticalLayout {
                padding: 0px;
                spacing: 0px;

                // --- Header (Height 52px) ---
                Rectangle {
                    height: Theme.header_height;
                    background: Theme.bg_surface;

                    Rectangle {
                        x: 0px;
                        y: parent.height - 1px;
                        width: parent.width;
                        height: 1px;
                        background: Theme.border;
                    }

                    HorizontalLayout {
                        padding-left: 20px;
                        padding-right: 16px;
                        alignment: space-between;
                        cross-axis-alignment: center;
                        spacing: Theme.space_md;

                        // Left: File Icon + File Name + Badges
                        HorizontalLayout {
                            spacing: 10px;
                            alignment: start;
                            cross-axis-alignment: center;
                            horizontal-stretch: 1;

                            Rectangle {
                                width: 32px;
                                height: 32px;
                                border-radius: Theme.radius_sm;
                                background: Theme.bg_active;

                                Image {
                                    source: root.is_image ? @image-url("../assets/icons/eye.svg") : (root.is_text ? @image-url("../assets/icons/file-text.svg") : @image-url("../assets/icons/file.svg"));
                                    width: 16px;
                                    height: 16px;
                                    colorize: Theme.accent;
                                    x: (parent.width - self.width) / 2;
                                    y: (parent.height - self.height) / 2;
                                }
                            }

                            VerticalLayout {
                                spacing: 2px;
                                alignment: center;
                                horizontal-stretch: 1;

                                Text {
                                    text: root.file_name;
                                    font-size: 14px;
                                    font-weight: 700;
                                    color: Theme.text_primary;
                                    overflow: elide;
                                }

                                HorizontalLayout {
                                    spacing: 6px;
                                    alignment: start;
                                    cross-axis-alignment: center;

                                    Text {
                                        text: root.file_size_formatted;
                                        font-size: Theme.font_xs;
                                        font-weight: 500;
                                        color: Theme.text_secondary;
                                    }

                                    if root.created_at_formatted != "" : Text {
                                        text: "•";
                                        font-size: 10px;
                                        color: Theme.text_muted;
                                    }

                                    if root.created_at_formatted != "" : Text {
                                        text: root.created_at_formatted;
                                        font-size: Theme.font_xs;
                                        color: Theme.text_muted;
                                    }
                                }
                            }
                        }

                        // Right: Actions (Download + Close)
                        HorizontalLayout {
                            spacing: Theme.space_sm;
                            alignment: end;
                            cross-axis-alignment: center;

                            AppButton {
                                text: "Save to Disk";
                                variant: "primary";
                                compact: true;
                                show_icon: true;
                                icon: @image-url("../assets/icons/download.svg");
                                clicked => {
                                    root.download(root.attachment_id);
                                }
                            }

                            ModalCloseButton {
                                clicked => {
                                    root.close();
                                }
                            }
                        }
                    }
                }

                // --- Content Body ---
                Rectangle {
                    vertical-stretch: 1;
                    background: Theme.bg_main;

                    // CASE 1: Image Preview
                    if root.is_image : VerticalLayout {
                        padding: 16px;

                        Image {
                            source: root.preview_image;
                            image-fit: contain;
                            width: 100%;
                            height: 100%;
                        }
                    }

                    // CASE 2: Text Preview
                    if root.is_text : VerticalLayout {
                        padding: 16px;

                        Rectangle {
                            background: Theme.bg_surface;
                            border-radius: Theme.radius_md;
                            border-width: 1px;
                            border-color: Theme.border;
                            clip: true;

                            text_scroll := ScrollView {
                                width: 100%;
                                height: 100%;
                                content-width: self.visible-width;
                                content-height: max(self.visible-height, preview_txt.preferred-height + 28px);

                                Rectangle {
                                    width: text_scroll.visible-width;
                                    height: max(text_scroll.visible-height, preview_txt.preferred-height + 28px);

                                    preview_txt := TextInput {
                                        x: 14px;
                                        y: 14px;
                                        width: max(100px, parent.width - 36px);
                                        read-only: true;
                                        single-line: false;
                                        wrap: word-wrap;
                                        font-family: "Consolas, 'Cascadia Code', 'Fira Code', 'Courier New', monospace";
                                        font-size: Theme.font_sm;
                                        color: Theme.text_primary;
                                        selection-background-color: Theme.accent;
                                        selection-foreground-color: Theme.accent_text;
                                        text: root.preview_text;
                                    }
                                }
                            }
                        }
                    }

                    // CASE 3: Error
                    if root.preview_error != "" : VerticalLayout {
                        alignment: center;
                        cross-axis-alignment: center;
                        spacing: 12px;
                        padding: 24px;

                        Image {
                            source: @image-url("../assets/icons/alert-triangle.svg");
                            width: 36px;
                            height: 36px;
                            colorize: Theme.danger;
                        }

                        Text {
                            text: "Unable to load preview";
                            font-size: 15px;
                            font-weight: 600;
                            color: Theme.text_primary;
                        }

                        Text {
                            text: root.preview_error;
                            font-size: Theme.font_sm;
                            color: Theme.text_secondary;
                            wrap: word-wrap;
                            horizontal-alignment: center;
                        }
                    }

                    // CASE 4: Other / Binary / Unsupported
                    if !root.is_image && !root.is_text && root.preview_error == "" : VerticalLayout {
                        alignment: center;
                        cross-axis-alignment: center;
                        spacing: 12px;
                        padding: 24px;

                        Rectangle {
                            width: 64px;
                            height: 64px;
                            border-radius: Theme.radius_lg;
                            background: Theme.bg_active;

                            Image {
                                source: @image-url("../assets/icons/file.svg");
                                width: 32px;
                                height: 32px;
                                colorize: Theme.accent;
                                x: (parent.width - self.width) / 2;
                                y: (parent.height - self.height) / 2;
                            }
                        }

                        Text {
                            text: root.file_name;
                            font-size: Theme.font_lg;
                            font-weight: 700;
                            color: Theme.text_primary;
                        }

                        Text {
                            text: root.file_size_formatted;
                            font-size: Theme.font_sm;
                            color: Theme.text_secondary;
                        }

                        Text {
                            text: "Direct inline preview is not supported for this file type.\nYou can save the attachment to your disk to view it with your system applications.";
                            font-size: Theme.font_sm;
                            color: Theme.text_muted;
                            horizontal-alignment: center;
                            wrap: word-wrap;
                        }

                        AppButton {
                            text: "Save File to Disk";
                            variant: "primary";
                            show_icon: true;
                            icon: @image-url("../assets/icons/download.svg");
                            clicked => {
                                root.download(root.attachment_id);
                            }
                        }
                    }
                }

                // --- Footer (Height 44px) ---
                Rectangle {
                    height: 44px;
                    background: Theme.bg_surface;

                    Rectangle {
                        x: 0px;
                        y: 0px;
                        width: parent.width;
                        height: 1px;
                        background: Theme.border;
                    }

                    HorizontalLayout {
                        padding-left: 20px;
                        padding-right: 16px;
                        alignment: space-between;
                        cross-axis-alignment: center;

                        Text {
                            text: root.is_image ? "Image Preview" : (root.is_text ? "Text Preview" : "Encrypted Attachment");
                            font-size: Theme.font_xs;
                            color: Theme.text_muted;
                            vertical-alignment: center;
                        }

                        AppButton {
                            text: "Close (Esc)";
                            variant: "secondary";
                            compact: true;
                            clicked => {
                                root.close();
                            }
                        }
                    }
                }
            }
        }
    }
}

// ==========================================
// MODAL: NEW NOTE TYPE SELECTION
// ==========================================
export component NewNoteModal inherits Rectangle {
    x: 0px;
    y: 0px;
    width: 100%;
    height: 100%;
    background: Theme.overlay;

    callback select_type(string);
    callback close();

    TouchArea {
        clicked => {
            root.close();
        }
    }

    Rectangle {
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        width: Theme.modal_width_md;
        height: min(parent.height - 48px, content_layout.preferred-height);
        background: Theme.bg_surface;
        border-radius: Theme.radius_lg;
        border-width: 1px;
        border-color: Theme.border_active;
        drop-shadow-blur: 24px;
        drop-shadow-color: #00000040;
        drop-shadow-offset-y: 8px;
        clip: true;

        TouchArea {}

        content_layout := VerticalLayout {
            padding-top: Theme.modal_pad_y;
            padding-bottom: Theme.modal_pad_y;
            padding-left: Theme.modal_pad_x;
            padding-right: Theme.modal_pad_x;
            spacing: Theme.modal_spacing;
            alignment: start;

            VerticalLayout {
                spacing: 6px;

                ModalHeader {
                    title: "Create New Note";
                    show_icon: true;
                    icon: @image-url("../assets/icons/plus.svg");
                    icon_color: Theme.accent;
                    close_clicked => {
                        root.close();
                    }
                }

                Text {
                    text: "Select the format for the new note:";
                    font-size: Theme.font_sm;
                    color: Theme.text_secondary;
                }
            }

            // Cards container
            VerticalLayout {
                spacing: 10px;

                // Option 1: Text Note
                text_card := Rectangle {
                    height: 72px;
                    border-radius: Theme.radius_md;
                    border-width: 1px;
                    border-color: text_touch.has-hover ? Theme.accent : Theme.border;
                    background: text_touch.has-hover ? Theme.hover : Theme.bg_secondary;
                    animate background { duration: 120ms; }
                    animate border-color { duration: 120ms; }

                    text_touch := TouchArea {
                        mouse-cursor: pointer;
                        clicked => {
                            root.select_type("text");
                        }
                    }

                    HorizontalLayout {
                        padding-left: 16px;
                        padding-right: 16px;
                        spacing: 14px;
                        cross-axis-alignment: center;

                        Rectangle {
                            width: 40px;
                            height: 40px;
                            border-radius: Theme.radius_md;
                            background: Theme.bg_surface;
                            border-width: 1px;
                            border-color: Theme.border;

                            Image {
                                source: @image-url("../assets/icons/file-text.svg");
                                width: 20px;
                                height: 20px;
                                colorize: Theme.accent;
                                x: (parent.width - self.width) / 2;
                                y: (parent.height - self.height) / 2;
                            }
                        }

                        VerticalLayout {
                            spacing: 3px;
                            alignment: center;

                            Text {
                                text: "Text Note";
                                font-size: 14px;
                                font-weight: 600;
                                color: Theme.text_primary;
                            }

                            Text {
                                text: "Rich Markdown formatting, syntax highlighting, and tables.";
                                font-size: Theme.font_xs;
                                color: Theme.text_secondary;
                            }
                        }
                    }
                }

                // Option 2: Canvas Note
                canvas_card := Rectangle {
                    height: 72px;
                    border-radius: Theme.radius_md;
                    border-width: 1px;
                    border-color: canvas_touch.has-hover ? Theme.accent : Theme.border;
                    background: canvas_touch.has-hover ? Theme.hover : Theme.bg_secondary;
                    animate background { duration: 120ms; }
                    animate border-color { duration: 120ms; }

                    canvas_touch := TouchArea {
                        mouse-cursor: pointer;
                        clicked => {
                            root.select_type("canvas");
                        }
                    }

                    HorizontalLayout {
                        padding-left: 16px;
                        padding-right: 16px;
                        spacing: 14px;
                        cross-axis-alignment: center;

                        Rectangle {
                            width: 40px;
                            height: 40px;
                            border-radius: Theme.radius_md;
                            background: Theme.bg_surface;
                            border-width: 1px;
                            border-color: Theme.border;

                            Image {
                                source: @image-url("../assets/icons/brush.svg");
                                width: 20px;
                                height: 20px;
                                colorize: Theme.accent;
                                x: (parent.width - self.width) / 2;
                                y: (parent.height - self.height) / 2;
                            }
                        }

                        VerticalLayout {
                            spacing: 3px;
                            alignment: center;

                            Text {
                                text: "Canvas / Drawing Note";
                                font-size: 14px;
                                font-weight: 600;
                                color: Theme.text_primary;
                            }

                            Text {
                                text: "Freehand sketchpad with tiny-skia pen, colors, and eraser.";
                                font-size: Theme.font_xs;
                                color: Theme.text_secondary;
                            }
                        }
                    }
                }
            }

            // Cancel Button
            HorizontalLayout {
                alignment: end;

                AppButton {
                    text: "Cancel";
                    variant: "secondary";
                    clicked => {
                        root.close();
                    }
                }
            }
        }
    }
}

// ==========================================
// MODAL: CLEAR CANVAS CONFIRMATION
// ==========================================
export component ClearCanvasModal inherits Rectangle {
    x: 0px;
    y: 0px;
    width: 100%;
    height: 100%;
    background: Theme.overlay;

    callback confirm();
    callback close();

    TouchArea {
        clicked => {
            root.close();
        }
    }

    Rectangle {
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        width: Theme.modal_width_sm;
        height: min(parent.height - 48px, clear_content.preferred-height);
        background: Theme.bg_surface;
        border-radius: Theme.radius_lg;
        border-width: 1px;
        border-color: Theme.border_active;
        drop-shadow-blur: 24px;
        drop-shadow-color: #00000040;
        drop-shadow-offset-y: 8px;
        clip: true;

        TouchArea {}

        clear_content := VerticalLayout {
            padding-top: Theme.modal_pad_y;
            padding-bottom: Theme.modal_pad_y;
            padding-left: Theme.modal_pad_x;
            padding-right: Theme.modal_pad_x;
            spacing: Theme.modal_spacing;
            alignment: start;

            ModalHeader {
                title: "Clear Canvas";
                show_icon: true;
                icon: @image-url("../assets/icons/alert-triangle.svg");
                icon_color: Theme.danger;
                close_clicked => {
                    root.close();
                }
            }

            Text {
                text: "Are you sure you want to clear the entire canvas? All drawing strokes on this note will be erased. This action cannot be undone.";
                font-size: Theme.font_sm;
                color: Theme.text_secondary;
                wrap: word-wrap;
            }

            HorizontalLayout {
                spacing: Theme.space_sm;
                alignment: end;

                AppButton {
                    text: "Cancel";
                    variant: "secondary";
                    clicked => {
                        root.close();
                    }
                }

                AppButton {
                    text: "Clear Canvas";
                    variant: "danger";
                    clicked => {
                        root.confirm();
                    }
                }
            }
        }
    }
}

// ==========================================
// MODAL: CUSTOM COLOR PICKER
// ==========================================
export component CustomColorModal inherits Rectangle {
    x: 0px;
    y: 0px;
    width: 100%;
    height: 100%;
    background: Theme.overlay;

    in-out property <string> hex_code: "#1e1e1e";
    in-out property <color> preview_color: #1e1e1e;
    in-out property <float> hue_value: 0.0;
    in-out property <float> sat_value: 0.0;
    in-out property <float> light_value: 12.0;
    in property <string> modal_title: "Custom Drawing Color";

    callback apply_color(string);
    callback close();
    callback hex_changed(string);
    callback hsl_changed(float, float, float);

    TouchArea {
        clicked => {
            root.close();
        }
    }

    Rectangle {
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        width: 580px;
        height: min(parent.height - 48px, color_content.preferred-height);
        background: Theme.bg_surface;
        border-radius: Theme.radius_lg;
        border-width: 1px;
        border-color: Theme.border_active;
        drop-shadow-blur: 24px;
        drop-shadow-color: #00000040;
        drop-shadow-offset-y: 8px;
        clip: true;

        TouchArea {}

        color_content := VerticalLayout {
            padding-top: Theme.modal_pad_y;
            padding-bottom: Theme.modal_pad_y;
            padding-left: Theme.modal_pad_x;
            padding-right: Theme.modal_pad_x;
            spacing: Theme.modal_spacing;
            alignment: start;

            VerticalLayout {
                spacing: 6px;

                ModalHeader {
                    title: root.modal_title;
                    show_icon: true;
                    icon: @image-url("../assets/icons/palette.svg");
                    icon_color: Theme.accent;
                    close_clicked => {
                        root.close();
                    }
                }

                Text {
                    text: root.modal_title == "Canvas Background Color" ? "Select a preset or adjust Hue, Saturation, and Lightness for the canvas background:" : "Select a color preset or adjust Hue, Saturation, and Lightness sliders:";
                    font-size: Theme.font_sm;
                    color: Theme.text_secondary;
                    wrap: word-wrap;
                }
            }

            // Side-by-side: Swatches on left, HSL sliders on right
            HorizontalLayout {
                spacing: 18px;
                alignment: stretch;
                cross-axis-alignment: start;

                // Left: Swatches Palette (4 rows of 6 colors)
                VerticalLayout {
                    width: 216px;
                    spacing: 8px;

                    Text {
                        text: "Presets";
                        font-size: Theme.font_xs;
                        font-weight: 600;
                        color: Theme.text_secondary;
                    }

                    VerticalLayout {
                        spacing: 7px;

                        // Row 1: Grayscale & Neutrals
                        HorizontalLayout {
                            spacing: 8px;
                            alignment: start;

                            Rectangle {
                                width: 28px; height: 28px; border-radius: Theme.radius_sm; background: #000000;
                                border-width: root.hex_code == "#000000" ? 2px : 1px;
                                border-color: root.hex_code == "#000000" ? Theme.accent : #444444;
                                TouchArea { mouse-cursor: pointer; clicked => { root.hex_code = "#000000"; root.preview_color = #000000; root.hex_changed("#000000"); } }
                            }
                            Rectangle {
                                width: 28px; height: 28px; border-radius: Theme.radius_sm; background: #1e1e1e;
                                border-width: root.hex_code == "#1e1e1e" ? 2px : 1px;
                                border-color: root.hex_code == "#1e1e1e" ? Theme.accent : #444444;
                                TouchArea { mouse-cursor: pointer; clicked => { root.hex_code = "#1e1e1e"; root.preview_color = #1e1e1e; root.hex_changed("#1e1e1e"); } }
                            }
                            Rectangle {
                                width: 28px; height: 28px; border-radius: Theme.radius_sm; background: #475569;
                                border-width: root.hex_code == "#475569" ? 2px : 1px;
                                border-color: root.hex_code == "#475569" ? Theme.accent : #334155;
                                TouchArea { mouse-cursor: pointer; clicked => { root.hex_code = "#475569"; root.preview_color = #475569; root.hex_changed("#475569"); } }
                            }
                            Rectangle {
                                width: 28px; height: 28px; border-radius: Theme.radius_sm; background: #94a3b8;
                                border-width: root.hex_code == "#94a3b8" ? 2px : 1px;
                                border-color: root.hex_code == "#94a3b8" ? Theme.accent : #64748b;
                                TouchArea { mouse-cursor: pointer; clicked => { root.hex_code = "#94a3b8"; root.preview_color = #94a3b8; root.hex_changed("#94a3b8"); } }
                            }
                            Rectangle {
                                width: 28px; height: 28px; border-radius: Theme.radius_sm; background: #cbd5e1;
                                border-width: root.hex_code == "#cbd5e1" ? 2px : 1px;
                                border-color: root.hex_code == "#cbd5e1" ? Theme.accent : #94a3b8;
                                TouchArea { mouse-cursor: pointer; clicked => { root.hex_code = "#cbd5e1"; root.preview_color = #cbd5e1; root.hex_changed("#cbd5e1"); } }
                            }
                            Rectangle {
                                width: 28px; height: 28px; border-radius: Theme.radius_sm; background: #ffffff;
                                border-width: root.hex_code == "#ffffff" ? 2px : 1px;
                                border-color: root.hex_code == "#ffffff" ? Theme.accent : #cccccc;
                                TouchArea { mouse-cursor: pointer; clicked => { root.hex_code = "#ffffff"; root.preview_color = #ffffff; root.hex_changed("#ffffff"); } }
                            }
                        }

                        // Row 2: Warm & Yellows
                        HorizontalLayout {
                            spacing: 8px;
                            alignment: start;

                            Rectangle {
                                width: 28px; height: 28px; border-radius: Theme.radius_sm; background: #dc2626;
                                border-width: root.hex_code == "#dc2626" ? 2px : 0px; border-color: Theme.accent;
                                TouchArea { mouse-cursor: pointer; clicked => { root.hex_code = "#dc2626"; root.preview_color = #dc2626; root.hex_changed("#dc2626"); } }
                            }
                            Rectangle {
                                width: 28px; height: 28px; border-radius: Theme.radius_sm; background: #ef4444;
                                border-width: root.hex_code == "#ef4444" ? 2px : 0px; border-color: Theme.accent;
                                TouchArea { mouse-cursor: pointer; clicked => { root.hex_code = "#ef4444"; root.preview_color = #ef4444; root.hex_changed("#ef4444"); } }
                            }
                            Rectangle {
                                width: 28px; height: 28px; border-radius: Theme.radius_sm; background: #f97316;
                                border-width: root.hex_code == "#f97316" ? 2px : 0px; border-color: Theme.accent;
                                TouchArea { mouse-cursor: pointer; clicked => { root.hex_code = "#f97316"; root.preview_color = #f97316; root.hex_changed("#f97316"); } }
                            }
                            Rectangle {
                                width: 28px; height: 28px; border-radius: Theme.radius_sm; background: #f59e0b;
                                border-width: root.hex_code == "#f59e0b" ? 2px : 0px; border-color: Theme.accent;
                                TouchArea { mouse-cursor: pointer; clicked => { root.hex_code = "#f59e0b"; root.preview_color = #f59e0b; root.hex_changed("#f59e0b"); } }
                            }
                            Rectangle {
                                width: 28px; height: 28px; border-radius: Theme.radius_sm; background: #eab308;
                                border-width: root.hex_code == "#eab308" ? 2px : 0px; border-color: Theme.accent;
                                TouchArea { mouse-cursor: pointer; clicked => { root.hex_code = "#eab308"; root.preview_color = #eab308; root.hex_changed("#eab308"); } }
                            }
                            Rectangle {
                                width: 28px; height: 28px; border-radius: Theme.radius_sm; background: #84cc16;
                                border-width: root.hex_code == "#84cc16" ? 2px : 0px; border-color: Theme.accent;
                                TouchArea { mouse-cursor: pointer; clicked => { root.hex_code = "#84cc16"; root.preview_color = #84cc16; root.hex_changed("#84cc16"); } }
                            }
                        }

                        // Row 3: Greens & Blues
                        HorizontalLayout {
                            spacing: 8px;
                            alignment: start;

                            Rectangle {
                                width: 28px; height: 28px; border-radius: Theme.radius_sm; background: #16a34a;
                                border-width: root.hex_code == "#16a34a" ? 2px : 0px; border-color: Theme.accent;
                                TouchArea { mouse-cursor: pointer; clicked => { root.hex_code = "#16a34a"; root.preview_color = #16a34a; root.hex_changed("#16a34a"); } }
                            }
                            Rectangle {
                                width: 28px; height: 28px; border-radius: Theme.radius_sm; background: #10b981;
                                border-width: root.hex_code == "#10b981" ? 2px : 0px; border-color: Theme.accent;
                                TouchArea { mouse-cursor: pointer; clicked => { root.hex_code = "#10b981"; root.preview_color = #10b981; root.hex_changed("#10b981"); } }
                            }
                            Rectangle {
                                width: 28px; height: 28px; border-radius: Theme.radius_sm; background: #06b6d4;
                                border-width: root.hex_code == "#06b6d4" ? 2px : 0px; border-color: Theme.accent;
                                TouchArea { mouse-cursor: pointer; clicked => { root.hex_code = "#06b6d4"; root.preview_color = #06b6d4; root.hex_changed("#06b6d4"); } }
                            }
                            Rectangle {
                                width: 28px; height: 28px; border-radius: Theme.radius_sm; background: #0284c7;
                                border-width: root.hex_code == "#0284c7" ? 2px : 0px; border-color: Theme.accent;
                                TouchArea { mouse-cursor: pointer; clicked => { root.hex_code = "#0284c7"; root.preview_color = #0284c7; root.hex_changed("#0284c7"); } }
                            }
                            Rectangle {
                                width: 28px; height: 28px; border-radius: Theme.radius_sm; background: #3b82f6;
                                border-width: root.hex_code == "#3b82f6" ? 2px : 0px; border-color: Theme.accent;
                                TouchArea { mouse-cursor: pointer; clicked => { root.hex_code = "#3b82f6"; root.preview_color = #3b82f6; root.hex_changed("#3b82f6"); } }
                            }
                            Rectangle {
                                width: 28px; height: 28px; border-radius: Theme.radius_sm; background: #4f46e5;
                                border-width: root.hex_code == "#4f46e5" ? 2px : 0px; border-color: Theme.accent;
                                TouchArea { mouse-cursor: pointer; clicked => { root.hex_code = "#4f46e5"; root.preview_color = #4f46e5; root.hex_changed("#4f46e5"); } }
                            }
                        }

                        // Row 4: Purples & Pinks
                        HorizontalLayout {
                            spacing: 8px;
                            alignment: start;

                            Rectangle {
                                width: 28px; height: 28px; border-radius: Theme.radius_sm; background: #7c3aed;
                                border-width: root.hex_code == "#7c3aed" ? 2px : 0px; border-color: Theme.accent;
                                TouchArea { mouse-cursor: pointer; clicked => { root.hex_code = "#7c3aed"; root.preview_color = #7c3aed; root.hex_changed("#7c3aed"); } }
                            }
                            Rectangle {
                                width: 28px; height: 28px; border-radius: Theme.radius_sm; background: #a855f7;
                                border-width: root.hex_code == "#a855f7" ? 2px : 0px; border-color: Theme.accent;
                                TouchArea { mouse-cursor: pointer; clicked => { root.hex_code = "#a855f7"; root.preview_color = #a855f7; root.hex_changed("#a855f7"); } }
                            }
                            Rectangle {
                                width: 28px; height: 28px; border-radius: Theme.radius_sm; background: #c026d3;
                                border-width: root.hex_code == "#c026d3" ? 2px : 0px; border-color: Theme.accent;
                                TouchArea { mouse-cursor: pointer; clicked => { root.hex_code = "#c026d3"; root.preview_color = #c026d3; root.hex_changed("#c026d3"); } }
                            }
                            Rectangle {
                                width: 28px; height: 28px; border-radius: Theme.radius_sm; background: #db2777;
                                border-width: root.hex_code == "#db2777" ? 2px : 0px; border-color: Theme.accent;
                                TouchArea { mouse-cursor: pointer; clicked => { root.hex_code = "#db2777"; root.preview_color = #db2777; root.hex_changed("#db2777"); } }
                            }
                            Rectangle {
                                width: 28px; height: 28px; border-radius: Theme.radius_sm; background: #f43f5e;
                                border-width: root.hex_code == "#f43f5e" ? 2px : 0px; border-color: Theme.accent;
                                TouchArea { mouse-cursor: pointer; clicked => { root.hex_code = "#f43f5e"; root.preview_color = #f43f5e; root.hex_changed("#f43f5e"); } }
                            }
                            Rectangle {
                                width: 28px; height: 28px; border-radius: Theme.radius_sm; background: #e11d48;
                                border-width: root.hex_code == "#e11d48" ? 2px : 0px; border-color: Theme.accent;
                                TouchArea { mouse-cursor: pointer; clicked => { root.hex_code = "#e11d48"; root.preview_color = #e11d48; root.hex_changed("#e11d48"); } }
                            }
                        }
                    }
                }

                // Vertical Divider
                Rectangle {
                    width: 1px;
                    background: Theme.border;
                }

                // Right: HSL Sliders
                VerticalLayout {
                    horizontal-stretch: 1;
                    spacing: 10px;
                    alignment: start;

                    Text {
                        text: "Sliders (HSL)";
                        font-size: Theme.font_xs;
                        font-weight: 600;
                        color: Theme.text_secondary;
                    }

                    // Hue
                    VerticalLayout {
                        spacing: 3px;

                        HorizontalLayout {
                            alignment: space-between;
                            Text {
                                text: "Hue";
                                font-size: Theme.font_xs;
                                font-weight: 500;
                                color: Theme.text_primary;
                            }
                            Text {
                                text: @tr("{0}°", Math.round(root.hue_value));
                                font-size: Theme.font_xs;
                                font-weight: 600;
                                color: Theme.accent;
                            }
                        }

                        Rectangle {
                            height: 6px;
                            border-radius: 3px;
                            background: @linear-gradient(90deg, #ff0000 0%, #ffff00 17%, #00ff00 33%, #00ffff 50%, #0000ff 67%, #ff00ff 83%, #ff0000 100%);
                        }

                        Slider {
                            minimum: 0.0;
                            maximum: 360.0;
                            value <=> root.hue_value;
                            changed(v) => {
                                root.hsl_changed(root.hue_value, root.sat_value, root.light_value);
                            }
                        }
                    }

                    // Saturation
                    VerticalLayout {
                        spacing: 3px;

                        HorizontalLayout {
                            alignment: space-between;
                            Text {
                                text: "Saturation";
                                font-size: Theme.font_xs;
                                font-weight: 500;
                                color: Theme.text_primary;
                            }
                            Text {
                                text: @tr("{0}%", Math.round(root.sat_value));
                                font-size: Theme.font_xs;
                                font-weight: 600;
                                color: Theme.accent;
                            }
                        }

                        Slider {
                            minimum: 0.0;
                            maximum: 100.0;
                            value <=> root.sat_value;
                            changed(v) => {
                                root.hsl_changed(root.hue_value, root.sat_value, root.light_value);
                            }
                        }
                    }

                    // Lightness
                    VerticalLayout {
                        spacing: 3px;

                        HorizontalLayout {
                            alignment: space-between;
                            Text {
                                text: "Lightness";
                                font-size: Theme.font_xs;
                                font-weight: 500;
                                color: Theme.text_primary;
                            }
                            Text {
                                text: @tr("{0}%", Math.round(root.light_value));
                                font-size: Theme.font_xs;
                                font-weight: 600;
                                color: Theme.accent;
                            }
                        }

                        Slider {
                            minimum: 0.0;
                            maximum: 100.0;
                            value <=> root.light_value;
                            changed(v) => {
                                root.hsl_changed(root.hue_value, root.sat_value, root.light_value);
                            }
                        }
                    }
                }
            }

            // Custom Hex input with preview box
            HorizontalLayout {
                spacing: 12px;
                cross-axis-alignment: center;

                Rectangle {
                    width: 44px;
                    height: Theme.input_height;
                    border-radius: Theme.radius_sm;
                    background: root.preview_color;
                    border-width: 1px;
                    border-color: Theme.border;
                }

                hex_edit := LineEdit {
                    height: Theme.input_height;
                    text <=> root.hex_code;
                    placeholder-text: "#RRGGBB";
                    font-size: Theme.font_md;
                    horizontal-stretch: 1;
                    edited => {
                        root.hex_changed(self.text);
                    }
                    accepted => {
                        root.apply_color(root.hex_code);
                    }
                }
            }

            // Footer action buttons
            HorizontalLayout {
                spacing: Theme.space_sm;
                alignment: end;

                AppButton {
                    text: "Cancel";
                    variant: "secondary";
                    clicked => {
                        root.close();
                    }
                }

                AppButton {
                    text: "Apply Color";
                    variant: "primary";
                    clicked => {
                        root.apply_color(root.hex_code);
                    }
                }
            }
        }
    }
}

// ==========================================
// MODAL: EXIT CONFIRMATION
// ==========================================
export component ExitConfirmModal inherits Rectangle {
    x: 0px;
    y: 0px;
    width: 100%;
    height: 100%;
    background: Theme.overlay;

    in property <bool> has_unsaved_changes: false;
    callback cancel();
    callback exit();

    TouchArea {
        clicked => {
            root.cancel();
        }
    }

    Rectangle {
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        width: Theme.modal_width_sm;
        height: min(parent.height - 48px, content_layout.preferred-height);
        background: Theme.bg_surface;
        border-radius: Theme.radius_lg;
        border-width: 1px;
        border-color: Theme.border_active;
        drop-shadow-blur: 24px;
        drop-shadow-color: #00000040;
        drop-shadow-offset-y: 8px;
        clip: true;

        TouchArea {}

        content_layout := VerticalLayout {
            padding-top: Theme.modal_pad_y;
            padding-bottom: Theme.modal_pad_y;
            padding-left: Theme.modal_pad_x;
            padding-right: Theme.modal_pad_x;
            spacing: Theme.modal_spacing;
            alignment: start;

            ModalHeader {
                title: "Exit NoteVault";
                show_icon: true;
                icon: @image-url("../assets/icons/alert-triangle.svg");
                icon_color: root.has_unsaved_changes ? Theme.danger : Theme.accent;
                close_clicked => {
                    root.cancel();
                }
            }

            VerticalLayout {
                spacing: 4px;

                Text {
                    text: "Are you sure you want to exit?";
                    font-size: Theme.font_md;
                    color: Theme.text_primary;
                    horizontal-alignment: left;
                    wrap: word-wrap;
                }

                if root.has_unsaved_changes : Text {
                    text: "Any unsaved changes will be lost.";
                    font-size: Theme.font_xs;
                    color: Theme.danger;
                    horizontal-alignment: left;
                }
            }

            HorizontalLayout {
                spacing: Theme.space_sm;
                alignment: end;

                AppButton {
                    text: "Cancel";
                    variant: "secondary";
                    clicked => {
                        root.cancel();
                    }
                }

                AppButton {
                    text: "Exit";
                    variant: root.has_unsaved_changes ? "danger" : "primary";
                    clicked => {
                        root.exit();
                    }
                }
            }
        }
    }
}
