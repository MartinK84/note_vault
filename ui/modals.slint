// ==========================================
// MODAL: ADD TAG
// ==========================================
export struct TagSuggestion {
    name: string,
    count: int,
}

export component AddTagModal inherits Rectangle {
    x: 0px;
    y: 0px;
    width: 100%;
    height: 100%;
    background: Theme.overlay;

    in-out property <string> tag_name: "";
    in property <[TagSuggestion]> suggested_tags: [];
    in-out property <int> selected_index: -1;

    callback cancel();
    callback add(string);
    callback tag_input_changed(string);

    public function focus_input() {
        tag_input.focus();
    }

    init => {
        tag_input.focus();
    }

    fs := FocusScope {
        width: 100%;
        height: 100%;

        capture-key-pressed(event) => {
            if event.text == Key.Escape {
                root.cancel();
                return accept;
            }
            if event.text == Key.UpArrow {
                if root.suggested_tags.length > 0 {
                    if root.selected_index > 0 {
                        root.selected_index -= 1;
                    } else {
                        root.selected_index = -1;
                    }
                }
                return accept;
            }
            if event.text == Key.DownArrow {
                if root.suggested_tags.length > 0 {
                    root.selected_index = min(root.suggested_tags.length - 1, root.selected_index + 1);
                }
                return accept;
            }
            if event.text == Key.Return {
                if root.selected_index >= 0 && root.selected_index < root.suggested_tags.length {
                    root.add(root.suggested_tags[root.selected_index].name);
                    return accept;
                } else if root.tag_name != "" {
                    root.add(root.tag_name);
                    return accept;
                }
            }
            reject
        }

        key-pressed(event) => {
            if event.text == Key.Escape {
                root.cancel();
                return accept;
            }
            reject
        }

        TouchArea {
            clicked => {
                root.cancel();
            }
        }

        modal_box := Rectangle {
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
            width: Theme.modal_width_sm;
            height: min(parent.height - 48px, 380px);
            background: Theme.bg_surface;
            border-radius: Theme.radius_lg;
            border-width: 1px;
            border-color: Theme.border_active;
            drop-shadow-blur: 24px;
            drop-shadow-color: #00000040;
            drop-shadow-offset-y: 8px;
            clip: true;

            TouchArea {}

            VerticalLayout {
                padding-top: Theme.modal_pad_y;
                padding-bottom: Theme.modal_pad_y;
                padding-left: Theme.modal_pad_x;
                padding-right: Theme.modal_pad_x;
                spacing: 10px;

                ModalHeader {
                    title: "Add Tag";
                    show_icon: true;
                    icon: @image-url("../assets/icons/tag.svg");
                    icon_color: Theme.accent;
                    close_clicked => {
                        root.cancel();
                    }
                }

                // LineEdit
                tag_input := LineEdit {
                    height: Theme.input_height;
                    font-size: Theme.font_md;
                    text <=> root.tag_name;
                    placeholder-text: "Tag name or search existing...";
                    edited(text) => {
                        root.selected_index = -1;
                        root.tag_input_changed(text);
                    }
                    accepted => {
                        if root.selected_index >= 0 && root.selected_index < root.suggested_tags.length {
                            root.add(root.suggested_tags[root.selected_index].name);
                        } else if root.tag_name != "" {
                            root.add(root.tag_name);
                        }
                    }
                }

                // Subtitle / section label
                HorizontalLayout {
                    height: 16px;
                    cross-axis-alignment: center;

                    Text {
                        text: "EXISTING TAGS";
                        font-size: 10px;
                        font-weight: 700;
                        color: Theme.text_muted;
                        letter-spacing: 0.5px;
                        vertical-alignment: center;
                    }

                    Rectangle { horizontal-stretch: 1; }

                    if root.suggested_tags.length > 0 : Text {
                        text: root.suggested_tags.length + (root.suggested_tags.length == 1 ? " match" : " matches");
                        font-size: 10px;
                        color: Theme.text_muted;
                        vertical-alignment: center;
                    }
                }

                // Scrollable Suggestions List
                ScrollView {
                    vertical-stretch: 1;
                    min-height: 140px;

                    VerticalLayout {
                        spacing: 3px;
                        padding-right: 4px;
                        alignment: start;

                        if root.suggested_tags.length == 0 : Rectangle {
                            height: 130px;

                            VerticalLayout {
                                alignment: center;
                                spacing: 4px;

                                Text {
                                    text: root.tag_name == "" ? "No tags found on other notes" : "No existing tags match \"" + root.tag_name + "\"";
                                    font-size: Theme.font_sm;
                                    color: Theme.text_muted;
                                    horizontal-alignment: center;
                                    vertical-alignment: center;
                                    wrap: word-wrap;
                                }

                                if root.tag_name != "" : Text {
                                    text: "Press Enter or 'Add' to create new tag";
                                    font-size: Theme.font_xs;
                                    color: Theme.accent;
                                    horizontal-alignment: center;
                                    vertical-alignment: center;
                                }
                            }
                        }

                        if root.suggested_tags.length > 0 : VerticalLayout {
                            spacing: 3px;

                            for suggestion[idx] in root.suggested_tags : Rectangle {
                                height: 30px;
                                border-radius: Theme.radius_sm;
                                background: idx == root.selected_index ? Theme.bg_active : (item_touch.has-hover ? Theme.hover : Colors.transparent);

                                item_touch := TouchArea {
                                    mouse-cursor: pointer;
                                    clicked => {
                                        root.add(suggestion.name);
                                    }
                                }

                                HorizontalLayout {
                                    padding-left: 8px;
                                    padding-right: 8px;
                                    spacing: 8px;
                                    cross-axis-alignment: center;

                                    Image {
                                        source: @image-url("../assets/icons/tag.svg");
                                        width: 13px;
                                        height: 13px;
                                        colorize: idx == root.selected_index ? Theme.accent : Theme.text_secondary;
                                    }

                                    Text {
                                        text: suggestion.name;
                                        font-size: Theme.font_sm;
                                        font-weight: idx == root.selected_index ? 700 : 500;
                                        color: Theme.text_primary;
                                        vertical-alignment: center;
                                        overflow: elide;
                                        horizontal-stretch: 1;
                                    }

                                    Rectangle {
                                        background: Theme.bg_secondary;
                                        border-radius: 4px;
                                        border-width: 1px;
                                        border-color: Theme.border;
                                        height: 18px;

                                        HorizontalLayout {
                                            padding-left: 5px;
                                            padding-right: 5px;

                                            Text {
                                                text: suggestion.count == 1 ? "1 note" : (suggestion.count + " notes");
                                                font-size: 10px;
                                                color: Theme.text_muted;
                                                vertical-alignment: center;
                                            }
                                        }
                                    }

                                    if item_touch.has-hover || idx == root.selected_index : Text {
                                        text: "+ Add";
                                        font-size: Theme.font_xs;
                                        font-weight: 600;
                                        color: Theme.accent;
                                        vertical-alignment: center;
                                    }
                                }
                            }
                        }
                    }
                }

                // Separator
                Rectangle {
                    height: 1px;
                    background: Theme.border;
                }

                // Footer Buttons
                HorizontalLayout {
                    spacing: Theme.space_sm;
                    alignment: end;

                    AppButton {
                        text: "Cancel";
                        variant: "secondary";
                        clicked => {
                            root.cancel();
                        }
                    }

                    AppButton {
                        text: "Add";
                        variant: "primary";
                        enabled: root.tag_name != "" || (root.selected_index >= 0 && root.selected_index < root.suggested_tags.length);
                        clicked => {
                            if root.selected_index >= 0 && root.selected_index < root.suggested_tags.length {
                                root.add(root.suggested_tags[root.selected_index].name);
                            } else if root.tag_name != "" {
                                root.add(root.tag_name);
                            }
                        }
                    }
                }
            }
        }
    }
}

// ==========================================
// MODAL: ONBOARDING / STARTUP WELCOME MODAL
// ==========================================
export component WelcomeModal inherits Rectangle {
    x: 0px;
    y: 0px;
    width: 100%;
    height: 100%;
    background: Theme.overlay;

    in-out property <string> vault_path: "";
    in property <string> error_message: "";
    callback browse();
    callback open_vault(string);

    TouchArea {}

    Rectangle {
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        width: Theme.modal_width_md;
        height: min(parent.height - 48px, content_layout.preferred-height);
        background: Theme.bg_surface;
        border-radius: Theme.radius_lg;
        border-width: 1px;
        border-color: Theme.border_active;
        drop-shadow-blur: 24px;
        drop-shadow-color: #00000040;
        drop-shadow-offset-y: 8px;
        clip: true;

        TouchArea {}

        content_layout := VerticalLayout {
            padding-top: Theme.modal_pad_y;
            padding-bottom: Theme.modal_pad_y;
            padding-left: Theme.modal_pad_x;
            padding-right: Theme.modal_pad_x;
            spacing: Theme.modal_spacing;
            alignment: start;

            VerticalLayout {
                spacing: 6px;

                ModalHeader {
                    title: "Welcome to NoteVault";
                    show_icon: true;
                    icon: @image-url("../assets/icons/folder.svg");
                    icon_color: Theme.accent;
                    show_close: false;
                }

                Text {
                    text: "Please select a directory on your system to store your encrypted notes.";
                    font-size: Theme.font_sm;
                    color: Theme.text_secondary;
                    horizontal-alignment: left;
                    wrap: word-wrap;
                }
            }

            HorizontalLayout {
                spacing: Theme.space_sm;
                cross-axis-alignment: center;

                LineEdit {
                    height: Theme.input_height;
                    text: root.vault_path;
                    placeholder-text: "No vault directory selected...";
                    font-size: Theme.font_md;
                    enabled: false;
                    horizontal-stretch: 1;
                }

                AppButton {
                    text: "Browse...";
                    variant: "secondary";
                    clicked => {
                        root.browse();
                    }
                }
            }

            if root.error_message != "" : Text {
                text: root.error_message;
                font-size: Theme.font_sm;
                color: Theme.danger;
                horizontal-alignment: left;
                wrap: word-wrap;
            }

            HorizontalLayout {
                spacing: Theme.space_sm;

                AppButton {
                    text: "Open Vault";
                    variant: "primary";
                    enabled: root.vault_path != "";
                    horizontal-stretch: 1;
                    clicked => {
                        root.open_vault(root.vault_path);
                    }
                }
            }
        }
    }
}

// ==========================================
// MODAL: EXPORT VAULT TO MARKDOWN
// ==========================================
export component ExportModal inherits Rectangle {
    x: 0px;
    y: 0px;
    width: 100%;
    height: 100%;
    background: Theme.overlay;

    in-out property <string> export_path: "";
    in property <bool> is_exporting: false;
    in property <float> export_progress: 0.0;
    in property <string> export_status: "";

    callback browse();
    callback start_export();
    callback cancel();

    TouchArea {
        clicked => {
            if !root.is_exporting {
                root.cancel();
            }
        }
    }

    Rectangle {
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        width: Theme.modal_width_md;
        height: min(parent.height - 48px, content_layout.preferred-height);
        background: Theme.bg_surface;
        border-radius: Theme.radius_lg;
        border-width: 1px;
        border-color: Theme.border_active;
        drop-shadow-blur: 24px;
        drop-shadow-color: #00000040;
        drop-shadow-offset-y: 8px;
        clip: true;

        TouchArea {}

        content_layout := VerticalLayout {
            padding-top: Theme.modal_pad_y;
            padding-bottom: Theme.modal_pad_y;
            padding-left: Theme.modal_pad_x;
            padding-right: Theme.modal_pad_x;
            spacing: Theme.modal_spacing;
            alignment: start;

            // Modal Header
            VerticalLayout {
                spacing: 6px;

                ModalHeader {
                    title: "Export Vault to Markdown";
                    show_icon: true;
                    icon: @image-url("../assets/icons/file.svg");
                    icon_color: Theme.accent;
                    show_close: !root.is_exporting;
                    close_clicked => {
                        root.cancel();
                    }
                }

                Text {
                    text: "Decrypt all notes and save them as plain Markdown files with YAML frontmatter.";
                    font-size: Theme.font_sm;
                    color: Theme.text_secondary;
                    horizontal-alignment: left;
                    wrap: word-wrap;
                }
            }

            // Danger Warning Box
            Rectangle {
                background: Theme.danger_subtle;
                border-radius: Theme.radius_md;
                border-width: 1px;
                border-color: Theme.danger;

                VerticalLayout {
                    padding-top: 10px;
                    padding-bottom: 10px;
                    padding-left: 12px;
                    padding-right: 12px;

                    HorizontalLayout {
                        spacing: Theme.space_sm;
                        alignment: start;
                        cross-axis-alignment: center;

                        Image {
                            source: @image-url("../assets/icons/alert-triangle.svg");
                            width: 16px;
                            height: 16px;
                            colorize: Theme.danger;
                        }

                        Text {
                            text: "WARNING: Exported notes will be saved as plain text (.md) and will NO LONGER BE ENCRYPTED.";
                            font-size: Theme.font_xs;
                            font-weight: 700;
                            color: Theme.danger;
                            horizontal-alignment: left;
                            wrap: word-wrap;
                            horizontal-stretch: 1;
                        }
                    }
                }
            }

            // Export Destination Directory Row
            HorizontalLayout {
                spacing: Theme.space_sm;
                cross-axis-alignment: center;

                LineEdit {
                    height: Theme.input_height;
                    text: root.export_path;
                    placeholder-text: "No export directory selected...";
                    font-size: Theme.font_md;
                    enabled: false;
                    read-only: true;
                    horizontal-stretch: 1;
                }

                AppButton {
                    text: "Browse...";
                    variant: "secondary";
                    enabled: !root.is_exporting;
                    clicked => {
                        root.browse();
                    }
                }
            }

            // Progress Indicator (Only visible while exporting)
            if root.is_exporting : VerticalLayout {
                spacing: 6px;

                HorizontalLayout {
                    spacing: Theme.space_sm;

                    Text {
                        text: root.export_status != "" ? root.export_status : "Exporting notes...";
                        font-size: Theme.font_sm;
                        color: Theme.text_secondary;
                        horizontal-stretch: 1;
                        overflow: elide;
                    }

                    Text {
                        text: @tr("{0}%", Math.round(root.export_progress * 100));
                        font-size: Theme.font_sm;
                        font-weight: 600;
                        color: Theme.accent;
                    }
                }

                ProgressIndicator {
                    progress: root.export_progress;
                }
            }

            // Action Buttons
            HorizontalLayout {
                spacing: Theme.space_sm;
                alignment: end;

                AppButton {
                    text: "Cancel";
                    variant: "secondary";
                    enabled: !root.is_exporting;
                    clicked => {
                        root.cancel();
                    }
                }

                AppButton {
                    text: "Start Export";
                    variant: "primary";
                    enabled: root.export_path != "" && !root.is_exporting;
                    clicked => {
                        root.start_export();
                    }
                }
            }
        }
    }
}

