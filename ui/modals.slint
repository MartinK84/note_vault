import { LineEdit, ProgressIndicator, ComboBox, Palette, ScrollView, Slider } from "std-widgets.slint";
import { Theme } from "theme.slint";
import { AppButton, ModalCloseButton, ModalHeader } from "components.slint";

// ==========================================
// MODAL: VAULT PASSWORD UNLOCK
// ==========================================
export component UnlockModal inherits Rectangle {
    x: 0px;
    y: 0px;
    width: 100%;
    height: 100%;
    background: Theme.overlay;

    in-out property <string> password: "";
    in property <string> error_message: "";
    in property <bool> show_keyfile_browse: false;
    in property <int> focus_trigger: 0;
    callback unlock(string);
    callback browse_keyfile();
    callback close();

    init => {
        pwd_input.focus();
    }

    changed focus_trigger => {
        pwd_input.focus();
    }

    TouchArea {}

    Rectangle {
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        width: Theme.modal_width_md;
        height: min(parent.height - 48px, content_layout.preferred-height);
        background: Theme.bg_surface;
        border-radius: Theme.radius_lg;
        border-width: 1px;
        border-color: Theme.border_active;
        drop-shadow-blur: 24px;
        drop-shadow-color: #00000040;
        drop-shadow-offset-y: 8px;
        clip: true;

        TouchArea {}

        content_layout := VerticalLayout {
            padding-top: Theme.modal_pad_y;
            padding-bottom: Theme.modal_pad_y;
            padding-left: Theme.modal_pad_x;
            padding-right: Theme.modal_pad_x;
            spacing: Theme.modal_spacing;
            alignment: start;

            VerticalLayout {
                spacing: 6px;

                ModalHeader {
                    title: "Unlock Secure Vault";
                    show_icon: true;
                    icon: @image-url("../assets/icons/lock.svg");
                    icon_color: Theme.accent;
                    close_clicked => {
                        root.close();
                    }
                }

                Text {
                    text: "Enter your master passphrase to decrypt and access your notes.";
                    font-size: Theme.font_sm;
                    color: Theme.text_secondary;
                    horizontal-alignment: left;
                    wrap: word-wrap;
                }
            }

            pwd_input := LineEdit {
                height: Theme.input_height;
                text <=> root.password;
                input-type: InputType.password;
                placeholder-text: "Master Vault Password...";
                font-size: Theme.font_md;
                accepted => {
                    root.unlock(root.password);
                }
            }

            if root.error_message != "" : Text {
                text: root.error_message;
                font-size: Theme.font_sm;
                color: Theme.danger;
                horizontal-alignment: left;
                wrap: word-wrap;
            }

            HorizontalLayout {
                spacing: Theme.space_sm;
                alignment: root.show_keyfile_browse ? space-between : end;
                cross-axis-alignment: center;

                if root.show_keyfile_browse : AppButton {
                    text: "Browse Keyfile...";
                    variant: "secondary";
                    clicked => {
                        root.browse_keyfile();
                    }
                }

                AppButton {
                    text: "Unlock Vault";
                    variant: "primary";
                    horizontal-stretch: root.show_keyfile_browse ? 0 : 1;
                    clicked => {
                        root.unlock(root.password);
                    }
                }
            }
        }
    }
}

// ==========================================
// MODAL: LOADING / DECRYPTION PROGRESS
// ==========================================
export component LoadingModal inherits Rectangle {
    x: 0px;
    y: 0px;
    width: 100%;
    height: 100%;
    background: Theme.overlay;

    in property <float> progress: 0.0;
    in property <string> status_text: "";

    TouchArea {}

    Rectangle {
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        width: Theme.modal_width_sm;
        height: min(parent.height - 48px, content_layout.preferred-height);
        background: Theme.bg_surface;
        border-radius: Theme.radius_lg;
        border-width: 1px;
        border-color: Theme.border_active;
        drop-shadow-blur: 24px;
        drop-shadow-color: #00000040;
        drop-shadow-offset-y: 8px;
        clip: true;

        TouchArea {}

        content_layout := VerticalLayout {
            padding-top: Theme.modal_pad_y;
            padding-bottom: Theme.modal_pad_y;
            padding-left: Theme.modal_pad_x;
            padding-right: Theme.modal_pad_x;
            spacing: Theme.modal_spacing;
            alignment: start;

            ModalHeader {
                title: "Decrypting Vault Notes";
                show_icon: true;
                icon: @image-url("../assets/icons/refresh.svg");
                icon_color: Theme.accent;
                show_close: false;
            }

            VerticalLayout {
                spacing: 6px;

                HorizontalLayout {
                    spacing: Theme.space_sm;

                    Text {
                        text: root.status_text != "" ? root.status_text : "Decrypting notes...";
                        font-size: Theme.font_sm;
                        color: Theme.text_secondary;
                        horizontal-stretch: 1;
                        overflow: elide;
                    }

                    Text {
                        text: @tr("{0}%", Math.round(root.progress * 100));
                        font-size: Theme.font_sm;
                        font-weight: 600;
                        color: Theme.accent;
                    }
                }

                ProgressIndicator {
                    progress: root.progress;
                }
            }
        }
    }
}

