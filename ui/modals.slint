// ==========================================
// MODAL: ONBOARDING / STARTUP WELCOME MODAL
// ==========================================
export component WelcomeModal inherits Rectangle {
    x: 0px;
    y: 0px;
    width: 100%;
    height: 100%;
    background: Theme.modal_scrim;

    in-out property <string> vault_path: "";
    in property <string> error_message: "";
    callback browse();
    callback open_vault(string);

    TouchArea {}

    Rectangle {
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        width: 480px;
        height: 310px;
        background: Theme.surface;
        border-radius: 12px;
        border-width: 1px;
        border-color: Theme.border_strong;
        clip: true;

        VerticalLayout {
            padding: 28px;
            spacing: 16px;
            alignment: center;

            VerticalLayout {
                spacing: 6px;
                alignment: center;

                Text {
                    text: "🗄️";
                    font-size: 36px;
                    horizontal-alignment: center;
                }

                Text {
                    text: "Welcome to NoteVault";
                    font-size: 20px;
                    font-weight: 700;
                    color: Theme.text;
                    horizontal-alignment: center;
                }

                Text {
                    text: "Please select a directory on your system to store your encrypted notes.";
                    font-size: 13px;
                    color: Theme.text_secondary;
                    horizontal-alignment: center;
                    wrap: word-wrap;
                }
            }

            HorizontalLayout {
                spacing: 8px;

                LineEdit {
                    text: root.vault_path;
                    placeholder-text: "No vault directory selected...";
                    font-size: 13px;
                    enabled: false;
                    horizontal-stretch: 1;
                }

                Button {
                    text: "Browse...";
                    clicked => {
                        root.browse();
                    }
                }
            }

            if root.error_message != "" : Text {
                text: root.error_message;
                font-size: 12px;
                color: Theme.danger;
                horizontal-alignment: center;
            }

            HorizontalLayout {
                spacing: 10px;

                Button {
                    text: "Open Vault";
                    primary: true;
                    enabled: root.vault_path != "";
                    horizontal-stretch: 1;
                    clicked => {
                        root.open_vault(root.vault_path);
                    }
                }
            }
        }
    }
}
