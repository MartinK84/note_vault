import { Button, LineEdit, ProgressIndicator, ComboBox, Palette } from "std-widgets.slint";
import { Theme } from "theme.slint";

component ModalCloseButton inherits Rectangle {
    callback clicked();
    width: 26px;
    height: 26px;
    border-radius: 6px;
    background: touch.has-hover ? Theme.hover : Colors.transparent;

    touch := TouchArea {
        mouse-cursor: pointer;
        clicked => {
            root.clicked();
        }
    }

    Image {
        source: @image-url("../assets/icons/x.svg");
        width: 13px;
        height: 13px;
        colorize: touch.has-hover ? Theme.text_primary : Theme.text_secondary;
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
    }
}

// ==========================================
// MODAL: VAULT PASSWORD UNLOCK
// ==========================================
export component UnlockModal inherits Rectangle {
    x: 0px;
    y: 0px;
    width: 100%;
    height: 100%;
    background: Theme.overlay;

    in-out property <string> password: "";
    in property <string> error_message: "";
    callback unlock(string);
    callback close();

    TouchArea {}

    Rectangle {
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        width: 440px;
        height: root.error_message != "" ? 205px : 185px;
        background: Theme.bg_surface;
        border-radius: 12px;
        border-width: 1px;
        border-color: Theme.border_active;
        clip: true;

        VerticalLayout {
            padding-top: 16px;
            padding-bottom: 16px;
            padding-left: 24px;
            padding-right: 24px;
            spacing: 12px;
            alignment: start;

            VerticalLayout {
                spacing: 4px;
                alignment: start;

                HorizontalLayout {
                    spacing: 8px;
                    alignment: start;
                    cross-axis-alignment: center;

                    Image {
                        source: @image-url("../assets/icons/lock.svg");
                        width: 20px;
                        height: 20px;
                        colorize: Theme.accent;
                    }

                    Text {
                        text: "Unlock Secure Vault";
                        font-size: 18px;
                        font-weight: 700;
                        color: Theme.text_primary;
                        vertical-alignment: center;
                    }
                }

                Text {
                    text: "Enter your master passphrase to decrypt and access your notes.";
                    font-size: 12px;
                    color: Theme.text_secondary;
                    horizontal-alignment: left;
                    wrap: word-wrap;
                }
            }

            pwd_input := LineEdit {
                text <=> root.password;
                input-type: InputType.password;
                placeholder-text: "Master Vault Password...";
                font-size: 13px;
                accepted => {
                    root.unlock(root.password);
                }
            }

            if root.error_message != "" : Text {
                text: root.error_message;
                font-size: 12px;
                color: Theme.danger;
                horizontal-alignment: left;
            }

            HorizontalLayout {
                spacing: 10px;

                Button {
                    text: "Unlock Vault";
                    primary: true;
                    horizontal-stretch: 1;
                    clicked => {
                        root.unlock(root.password);
                    }
                }
            }
        }

        ModalCloseButton {
            x: parent.width - self.width - 12px;
            y: 12px;
            clicked => {
                root.close();
            }
        }
    }
}

// ==========================================
// MODAL: LOADING / DECRYPTION PROGRESS
// ==========================================
export component LoadingModal inherits Rectangle {
    x: 0px;
    y: 0px;
    width: 100%;
    height: 100%;
    background: Theme.overlay;

    in property <float> progress: 0.0;
    in property <string> status_text: "";

    TouchArea {}

    Rectangle {
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        width: 420px;
        height: 135px;
        background: Theme.bg_surface;
        border-radius: 12px;
        border-width: 1px;
        border-color: Theme.border_active;
        clip: true;

        VerticalLayout {
            padding-top: 16px;
            padding-bottom: 16px;
            padding-left: 24px;
            padding-right: 24px;
            spacing: 12px;
            alignment: start;

            HorizontalLayout {
                spacing: 8px;
                alignment: start;
                cross-axis-alignment: center;

                Image {
                    source: @image-url("../assets/icons/refresh.svg");
                    width: 20px;
                    height: 20px;
                    colorize: Theme.accent;
                }

                Text {
                    text: "Decrypting Vault Notes";
                    font-size: 17px;
                    font-weight: 700;
                    color: Theme.text_primary;
                    vertical-alignment: center;
                }
            }

            VerticalLayout {
                spacing: 6px;

                HorizontalLayout {
                    Text {
                        text: root.status_text != "" ? root.status_text : "Decrypting notes...";
                        font-size: 12px;
                        color: Theme.text_secondary;
                        horizontal-stretch: 1;
                        overflow: elide;
                    }

                    Text {
                        text: @tr("{0}%", Math.round(root.progress * 100));
                        font-size: 12px;
                        font-weight: 600;
                        color: Theme.accent;
                    }
                }

                ProgressIndicator {
                    progress: root.progress;
                }
            }
        }
    }
}

// ==========================================
// MODAL: UNSAVED CHANGES WARNING
// ==========================================
export component UnsavedWarningModal inherits Rectangle {
    x: 0px;
    y: 0px;
    width: 100%;
    height: 100%;
    background: Theme.overlay;

    callback cancel();
    callback discard();

    TouchArea {}

    Rectangle {
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        width: 420px;
        height: 135px;
        background: Theme.bg_surface;
        border-radius: 12px;
        border-width: 1px;
        border-color: Theme.border_active;
        clip: true;

        VerticalLayout {
            padding-top: 14px;
            padding-bottom: 14px;
            padding-left: 22px;
            padding-right: 22px;
            spacing: 10px;
            alignment: start;

            HorizontalLayout {
                spacing: 8px;
                alignment: start;
                cross-axis-alignment: center;

                Image {
                    source: @image-url("../assets/icons/alert-triangle.svg");
                    width: 18px;
                    height: 18px;
                    colorize: Theme.danger;
                }

                Text {
                    text: "Unsaved Changes";
                    font-size: 16px;
                    font-weight: 700;
                    color: Theme.danger;
                    vertical-alignment: center;
                }
            }

            Text {
                text: "You have unsaved changes. Do you want to discard them?";
                font-size: 13px;
                color: Theme.text_primary;
                horizontal-alignment: left;
                wrap: word-wrap;
            }

            HorizontalLayout {
                spacing: 10px;

                Button {
                    height: 28px;
                    text: "Cancel";
                    horizontal-stretch: 1;
                    clicked => {
                        root.cancel();
                    }
                }

                Button {
                    height: 28px;
                    text: "Discard Changes";
                    primary: true;
                    horizontal-stretch: 1;
                    clicked => {
                        root.discard();
                    }
                }
            }
        }

        ModalCloseButton {
            x: parent.width - self.width - 12px;
            y: 12px;
            clicked => {
                root.cancel();
            }
        }
    }
}

// ==========================================
