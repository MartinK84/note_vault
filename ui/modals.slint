import { Button, LineEdit, ProgressIndicator, ComboBox, Palette, ScrollView } from "std-widgets.slint";
import { Theme } from "theme.slint";

component ModalCloseButton inherits Rectangle {
    callback clicked();
    width: 26px;
    height: 26px;
    border-radius: 6px;
    background: touch.has-hover ? Theme.hover : Colors.transparent;

    touch := TouchArea {
        mouse-cursor: pointer;
        clicked => {
            root.clicked();
        }
    }

    Image {
        source: @image-url("../assets/icons/x.svg");
        width: 13px;
        height: 13px;
        colorize: touch.has-hover ? Theme.text_primary : Theme.text_secondary;
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
    }
}

// ==========================================
// MODAL: VAULT PASSWORD UNLOCK
// ==========================================
export component UnlockModal inherits Rectangle {
    x: 0px;
    y: 0px;
    width: 100%;
    height: 100%;
    background: Theme.overlay;

    in-out property <string> password: "";
    in property <string> error_message: "";
    in property <bool> show_keyfile_browse: false;
    callback unlock(string);
    callback browse_keyfile();
    callback close();

    TouchArea {}

    Rectangle {
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        width: 440px;
        height: content_layout.preferred-height;
        background: Theme.bg_surface;
        border-radius: 12px;
        border-width: 1px;
        border-color: Theme.border_active;
        clip: true;

        content_layout := VerticalLayout {
            padding-top: 16px;
            padding-bottom: 16px;
            padding-left: 24px;
            padding-right: 24px;
            spacing: 12px;
            alignment: start;

            VerticalLayout {
                spacing: 4px;
                alignment: start;

                HorizontalLayout {
                    spacing: 8px;
                    alignment: start;
                    cross-axis-alignment: center;

                    Image {
                        source: @image-url("../assets/icons/lock.svg");
                        width: 20px;
                        height: 20px;
                        colorize: Theme.accent;
                    }

                    Text {
                        text: "Unlock Secure Vault";
                        font-size: 18px;
                        font-weight: 700;
                        color: Theme.text_primary;
                        vertical-alignment: center;
                    }
                }

                Text {
                    text: "Enter your master passphrase to decrypt and access your notes.";
                    font-size: 12px;
                    color: Theme.text_secondary;
                    horizontal-alignment: left;
                    wrap: word-wrap;
                }
            }

            pwd_input := LineEdit {
                text <=> root.password;
                input-type: InputType.password;
                placeholder-text: "Master Vault Password...";
                font-size: 13px;
                accepted => {
                    root.unlock(root.password);
                }
            }

            if root.error_message != "" : Text {
                text: root.error_message;
                font-size: 12px;
                color: Theme.danger;
                horizontal-alignment: left;
                wrap: word-wrap;
            }

            if root.show_keyfile_browse : HorizontalLayout {
                spacing: 8px;
                alignment: start;

                Button {
                    text: "Browse Keyfile...";
                    clicked => {
                        root.browse_keyfile();
                    }
                }
            }

            HorizontalLayout {
                spacing: 10px;

                Button {
                    text: "Unlock Vault";
                    primary: true;
                    horizontal-stretch: 1;
                    clicked => {
                        root.unlock(root.password);
                    }
                }
            }
        }

        ModalCloseButton {
            x: parent.width - self.width - 12px;
            y: 12px;
            clicked => {
                root.close();
            }
        }
    }
}

// ==========================================
// MODAL: LOADING / DECRYPTION PROGRESS
// ==========================================
export component LoadingModal inherits Rectangle {
    x: 0px;
    y: 0px;
    width: 100%;
    height: 100%;
    background: Theme.overlay;

    in property <float> progress: 0.0;
    in property <string> status_text: "";

    TouchArea {}

    Rectangle {
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        width: 420px;
        height: 135px;
        background: Theme.bg_surface;
        border-radius: 12px;
        border-width: 1px;
        border-color: Theme.border_active;
        clip: true;

        VerticalLayout {
            padding-top: 16px;
            padding-bottom: 16px;
            padding-left: 24px;
            padding-right: 24px;
            spacing: 12px;
            alignment: start;

            HorizontalLayout {
                spacing: 8px;
                alignment: start;
                cross-axis-alignment: center;

                Image {
                    source: @image-url("../assets/icons/refresh.svg");
                    width: 20px;
                    height: 20px;
                    colorize: Theme.accent;
                }

                Text {
                    text: "Decrypting Vault Notes";
                    font-size: 17px;
                    font-weight: 700;
                    color: Theme.text_primary;
                    vertical-alignment: center;
                }
            }

            VerticalLayout {
                spacing: 6px;

                HorizontalLayout {
                    Text {
                        text: root.status_text != "" ? root.status_text : "Decrypting notes...";
                        font-size: 12px;
                        color: Theme.text_secondary;
                        horizontal-stretch: 1;
                        overflow: elide;
                    }

                    Text {
                        text: @tr("{0}%", Math.round(root.progress * 100));
                        font-size: 12px;
                        font-weight: 600;
                        color: Theme.accent;
                    }
                }

                ProgressIndicator {
                    progress: root.progress;
                }
            }
        }
    }
}

