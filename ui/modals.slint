    in-out property <string> new_name: "";
    in property <string> error_message: "";
    callback cancel();
    callback rename(string, string);

    TouchArea {
        clicked => {
            root.cancel();
        }
    }

    Rectangle {
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        width: Theme.modal_width_sm;
        height: min(parent.height - 48px, content_layout.preferred-height);
        background: Theme.bg_surface;
        border-radius: Theme.radius_lg;
        border-width: 1px;
        border-color: Theme.border_active;
        drop-shadow-blur: 24px;
        drop-shadow-color: #00000040;
        drop-shadow-offset-y: 8px;
        clip: true;

        TouchArea {}

        content_layout := VerticalLayout {
            padding-top: Theme.modal_pad_y;
            padding-bottom: Theme.modal_pad_y;
            padding-left: Theme.modal_pad_x;
            padding-right: Theme.modal_pad_x;
            spacing: Theme.modal_spacing;
            alignment: start;

            ModalHeader {
                title: "Rename Folder";
                show_icon: true;
                icon: @image-url("../assets/icons/edit.svg");
                icon_color: Theme.accent;
                close_clicked => {
                    root.cancel();
                }
            }

            rename_input := LineEdit {
                height: Theme.input_height;
                font-size: Theme.font_md;
                text <=> root.new_name;
                placeholder-text: "New folder name...";
                accepted => {
                    if root.new_name != "" && root.new_name != root.target_folder_name {
                        root.rename(root.target_folder_name, root.new_name);
                    }
                }
            }

            if root.error_message != "" : Text {
                text: root.error_message;
                font-size: Theme.font_xs;
                color: Theme.danger;
                horizontal-alignment: left;
                wrap: word-wrap;
            }

            HorizontalLayout {
                spacing: Theme.space_sm;
                alignment: end;

                AppButton {
                    text: "Cancel";
                    variant: "secondary";
                    clicked => {
                        root.cancel();
                    }
                }

                AppButton {
                    text: "Rename";
                    variant: "primary";
                    enabled: root.new_name != "" && root.new_name != root.target_folder_name;
                    clicked => {
                        root.rename(root.target_folder_name, root.new_name);
                    }
                }
            }
        }
    }
}

