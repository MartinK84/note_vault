import { Button, LineEdit, ProgressIndicator, ComboBox } from "std-widgets.slint";
import { Theme } from "theme.slint";

// ==========================================
// MODAL: VAULT PASSWORD UNLOCK
// ==========================================
export component UnlockModal inherits Rectangle {
    x: 0px;
    y: 0px;
    width: 100%;
    height: 100%;
    background: Theme.modal_scrim;

    in-out property <string> password: "";
    in property <string> error_message: "";
    callback unlock(string);

    TouchArea {}

    Rectangle {
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        width: 440px;
        height: 290px;
        background: Theme.surface;
        border-radius: 12px;
        border-width: 1px;
        border-color: Theme.border_strong;
        clip: true;

        VerticalLayout {
            padding: 28px;
            spacing: 16px;
            alignment: center;

            VerticalLayout {
                spacing: 6px;
                alignment: center;

                Text {
                    text: "🔐";
                    font-size: 32px;
                    horizontal-alignment: center;
                }

                Text {
                    text: "Unlock Secure Vault";
                    font-size: 20px;
                    font-weight: 700;
                    color: Theme.text;
                    horizontal-alignment: center;
                }

                Text {
                    text: "Enter your master passphrase to decrypt and access your notes.";
                    font-size: 13px;
                    color: Theme.text_secondary;
                    horizontal-alignment: center;
                    wrap: word-wrap;
                }
            }

            pwd_input := LineEdit {
                text <=> root.password;
                input-type: InputType.password;
                placeholder-text: "Master Vault Password...";
                font-size: 14px;
                accepted => {
                    root.unlock(root.password);
                }
            }

            if root.error_message != "" : Text {
                text: root.error_message;
                font-size: 12px;
                color: Theme.danger;
                horizontal-alignment: center;
            }

            HorizontalLayout {
                spacing: 10px;

                Button {
                    text: "Unlock Vault";
                    primary: true;
                    horizontal-stretch: 1;
                    clicked => {
                        root.unlock(root.password);
                    }
                }
            }
        }
    }
}

// ==========================================
// MODAL: LOADING / DECRYPTION PROGRESS
// ==========================================
export component LoadingModal inherits Rectangle {
    x: 0px;
    y: 0px;
    width: 100%;
    height: 100%;
    background: Theme.modal_scrim;

    in property <float> progress: 0.0;
    in property <string> status_text: "";

    TouchArea {}

    Rectangle {
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        width: 420px;
        height: 190px;
        background: Theme.surface;
        border-radius: 12px;
        border-width: 1px;
        border-color: Theme.border_strong;
        clip: true;

        VerticalLayout {
            padding: 28px;
            spacing: 18px;
            alignment: center;

            HorizontalLayout {
                spacing: 10px;
                alignment: center;

                Text {
                    text: "🔄";
                    font-size: 24px;
                    vertical-alignment: center;
                }

                Text {
                    text: "Decrypting Vault Notes";
                    font-size: 18px;
                    font-weight: 700;
                    color: Theme.text;
                    vertical-alignment: center;
                }
            }

            VerticalLayout {
                spacing: 8px;

                HorizontalLayout {
                    Text {
                        text: root.status_text != "" ? root.status_text : "Decrypting notes...";
                        font-size: 12px;
                        color: Theme.text_secondary;
                        horizontal-stretch: 1;
                        overflow: elide;
                    }

                    Text {
                        text: @tr("{0}%", Math.round(root.progress * 100));
                        font-size: 12px;
                        font-weight: 600;
                        color: Theme.primary;
                    }
                }

                ProgressIndicator {
                    progress: root.progress;
                }
            }
        }
    }
}

// ==========================================
// MODAL: UNSAVED CHANGES WARNING
// ==========================================
export component UnsavedWarningModal inherits Rectangle {
    x: 0px;
    y: 0px;
    width: 100%;
    height: 100%;
    background: Theme.modal_scrim;

    callback cancel();
    callback discard();

    TouchArea {}

    Rectangle {
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        width: 420px;
        height: 190px;
        background: Theme.surface;
        border-radius: 12px;
        border-width: 1px;
        border-color: Theme.border_strong;
        clip: true;

        VerticalLayout {
            padding: 24px;
            spacing: 14px;
            alignment: center;

            Text {
                text: "⚠️ Unsaved Changes";
                font-size: 16px;
                font-weight: 700;
                color: Theme.danger;
                horizontal-alignment: center;
            }

            Text {
                text: "You have unsaved changes. Do you want to discard them?";
                font-size: 13px;
                color: Theme.text;
                horizontal-alignment: center;
                wrap: word-wrap;
            }

            HorizontalLayout {
                spacing: 10px;

                Button {
                    height: 28px;
                    text: "Cancel";
                    horizontal-stretch: 1;
                    clicked => {
                        root.cancel();
                    }
                }

                Button {
                    height: 28px;
                    text: "Discard Changes";
                    primary: true;
                    horizontal-stretch: 1;
                    clicked => {
                        root.discard();
                    }
                }
            }
        }
    }
}

// ==========================================
// MODAL: DELETE FOLDER WARNING
// ==========================================
export component DeleteFolderModal inherits Rectangle {
    x: 0px;
    y: 0px;
    width: 100%;
    height: 100%;
    background: Theme.modal_scrim;

    in property <string> folder_name: "";
    callback cancel();
    callback delete(string);

    TouchArea {}

    Rectangle {
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        width: 420px;
        height: 230px;
        background: Theme.surface;
        border-radius: 12px;
        border-width: 1px;
        border-color: Theme.border_strong;
        clip: true;

        VerticalLayout {
            padding: 24px;
            spacing: 14px;
            alignment: center;

            Text {
                text: "Delete Folder";
                font-size: 16px;
                font-weight: 700;
                color: Theme.danger;
                horizontal-alignment: center;
            }

            Text {
                text: "Delete folder \"" + root.folder_name + "\"?";
                font-size: 14px;
                font-weight: 600;
                color: Theme.text;
                horizontal-alignment: center;
                overflow: elide;
            }

            Text {
                text: "Are you sure? This will permanently delete all encrypted notes inside this folder.";
                font-size: 12px;
                color: Theme.danger;
                horizontal-alignment: center;
                wrap: word-wrap;
            }

            HorizontalLayout {
                spacing: 10px;

                Button {
                    height: 28px;
                    text: "Cancel";
                    horizontal-stretch: 1;
                    clicked => {
                        root.cancel();
                    }
                }

                Button {
                    height: 28px;
                    text: "Delete Permanently";
                    primary: true;
                    horizontal-stretch: 1;
                    clicked => {
                        root.delete(root.folder_name);
                    }
                }
            }
        }
    }
}

