// ==========================================
// MODAL: CREATE NEW FOLDER
// ==========================================
export component FolderModal inherits Rectangle {
    x: 0px;
    y: 0px;
    width: 100%;
    height: 100%;
    background: Theme.modal_scrim;

    in-out property <string> folder_name: "";
    callback cancel();
    callback create(string);

    TouchArea {}

    Rectangle {
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        width: 360px;
        height: 180px;
        background: Theme.surface;
        border-radius: 12px;
        border-width: 1px;
        border-color: Theme.border_strong;
        clip: true;

        VerticalLayout {
            padding: 24px;
            spacing: 14px;
            alignment: center;

            Text {
                text: "Create New Folder";
                font-size: 16px;
                font-weight: 700;
                color: Theme.text;
                horizontal-alignment: center;
            }

            folder_name_input := LineEdit {
                height: 28px;
                font-size: 13px;
                text <=> root.folder_name;
                placeholder-text: "Folder name...";
                accepted => {
                    if root.folder_name != "" {
                        root.create(root.folder_name);
                    }
                }
            }

            HorizontalLayout {
                spacing: 10px;

                Button {
                    height: 28px;
                    text: "Cancel";
                    horizontal-stretch: 1;
                    clicked => {
                        root.cancel();
                    }
                }

                Button {
                    height: 28px;
                    text: "Create";
                    primary: true;
                    enabled: root.folder_name != "";
                    horizontal-stretch: 1;
                    clicked => {
                        root.create(root.folder_name);
                    }
                }
            }
        }
    }
}

// ==========================================
// MODAL: RENAME FOLDER
// ==========================================
export component RenameFolderModal inherits Rectangle {
    x: 0px;
    y: 0px;
    width: 100%;
    height: 100%;
    background: Theme.modal_scrim;

    in property <string> target_folder_name: "";
    in-out property <string> new_name: "";
    callback cancel();
    callback rename(string, string);

    TouchArea {}

    Rectangle {
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        width: 380px;
        height: 200px;
        background: Theme.surface;
        border-radius: 12px;
        border-width: 1px;
        border-color: Theme.border_strong;
        clip: true;

        VerticalLayout {
            padding: 24px;
            spacing: 14px;
            alignment: center;

            Text {
                text: "Rename Folder";
                font-size: 16px;
                font-weight: 700;
                color: Theme.text;
                horizontal-alignment: center;
            }

            rename_input := LineEdit {
                height: 28px;
                font-size: 13px;
                text <=> root.new_name;
                placeholder-text: "New folder name...";
                accepted => {
                    if root.new_name != "" && root.new_name != root.target_folder_name {
                        root.rename(root.target_folder_name, root.new_name);
                    }
                }
            }

            HorizontalLayout {
                spacing: 10px;

                Button {
                    height: 28px;
                    text: "Cancel";
                    horizontal-stretch: 1;
                    clicked => {
                        root.cancel();
                    }
                }

                Button {
                    height: 28px;
                    text: "Rename";
                    primary: true;
                    enabled: root.new_name != "" && root.new_name != root.target_folder_name;
                    horizontal-stretch: 1;
                    clicked => {
                        root.rename(root.target_folder_name, root.new_name);
                    }
                }
            }
        }
    }
}

// ==========================================
// MODAL: MOVE NOTE
// ==========================================
export component MoveNoteModal inherits Rectangle {
    x: 0px;
    y: 0px;
    width: 100%;
    height: 100%;
    background: Theme.modal_scrim;

    in property <string> note_title: "";
    in property <[string]> available_folders: [];
    in-out property <string> target_folder: "General";
    callback cancel();
    callback move_note(string);

    TouchArea {}

    Rectangle {
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        width: 380px;
        height: 220px;
        background: Theme.surface;
        border-radius: 12px;
        border-width: 1px;
        border-color: Theme.border_strong;
        clip: true;

        VerticalLayout {
            padding: 24px;
            spacing: 14px;
            alignment: center;

            Text {
                text: "Move Note";
                font-size: 16px;
                font-weight: 700;
                color: Theme.text;
                horizontal-alignment: center;
            }

            Text {
                text: "Move \"" + root.note_title + "\" to:";
                font-size: 13px;
                color: Theme.text_secondary;
                horizontal-alignment: center;
                overflow: elide;
            }

            HorizontalLayout {
                spacing: 6px;
                alignment: center;

                Text {
                    text: "Folder:";
                    font-size: 12px;
                    color: Theme.text_secondary;
                    vertical-alignment: center;
                }

                ComboBox {
                    height: 28px;
                    horizontal-stretch: 1;
                    model: root.available_folders;
                    current-value: root.target_folder;
                    selected(val) => {
                        root.target_folder = val;
                    }
                }
            }

            HorizontalLayout {
                spacing: 10px;

                Button {
                    height: 28px;
                    text: "Cancel";
                    horizontal-stretch: 1;
                    clicked => {
                        root.cancel();
                    }
                }

                Button {
                    height: 28px;
                    text: "Move";
                    primary: true;
                    horizontal-stretch: 1;
                    clicked => {
                        root.move_note(root.target_folder);
                    }
                }
            }
        }
    }
}

