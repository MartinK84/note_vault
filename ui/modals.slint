// ==========================================
// MODAL: CREATE NEW FOLDER
// ==========================================
export component FolderModal inherits Rectangle {
    x: 0px;
    y: 0px;
    width: 100%;
    height: 100%;
    background: Theme.overlay;

    in-out property <string> folder_name: "";
    in property <string> error_message: "";
    callback cancel();
    callback create(string);

    TouchArea {}

    Rectangle {
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        width: 380px;
        height: root.error_message != "" ? 162px : 135px;
        background: Theme.bg_surface;
        border-radius: 12px;
        border-width: 1px;
        border-color: Theme.border_active;
        clip: true;

        VerticalLayout {
            padding-top: 14px;
            padding-bottom: 14px;
            padding-left: 20px;
            padding-right: 20px;
            spacing: 10px;
            alignment: start;

            HorizontalLayout {
                spacing: 8px;
                alignment: start;
                cross-axis-alignment: center;

                Image {
                    source: @image-url("../assets/icons/folder-plus.svg");
                    width: 18px;
                    height: 18px;
                    colorize: Theme.accent;
                }

                Text {
                    text: "Create New Folder";
                    font-size: 16px;
                    font-weight: 700;
                    color: Theme.text_primary;
                    vertical-alignment: center;
                }
            }

            folder_name_input := LineEdit {
                height: 28px;
                font-size: 13px;
                text <=> root.folder_name;
                placeholder-text: "Folder name...";
                accepted => {
                    if root.folder_name != "" {
                        root.create(root.folder_name);
                    }
                }
            }

            if root.error_message != "" : Text {
                text: root.error_message;
                font-size: 11px;
                color: Theme.danger;
                horizontal-alignment: left;
                wrap: word-wrap;
            }

            HorizontalLayout {
                spacing: 10px;

                Button {
                    height: 28px;
                    text: "Cancel";
                    horizontal-stretch: 1;
                    clicked => {
                        root.cancel();
                    }
                }

                Button {
                    height: 28px;
                    text: "Create";
                    primary: true;
                    enabled: root.folder_name != "";
                    horizontal-stretch: 1;
                    clicked => {
                        root.create(root.folder_name);
                    }
                }
            }
        }

        ModalCloseButton {
            x: parent.width - self.width - 12px;
            y: 12px;
            clicked => {
                root.cancel();
            }
        }
    }
}

