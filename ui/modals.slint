// ==========================================
// MODAL: ONBOARDING / STARTUP WELCOME MODAL
// ==========================================
export component WelcomeModal inherits Rectangle {
    x: 0px;
    y: 0px;
    width: 100%;
    height: 100%;
    background: Theme.overlay;

    in-out property <string> vault_path: "";
    in property <string> error_message: "";
    callback browse();
    callback open_vault(string);

    TouchArea {}

    Rectangle {
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        width: 480px;
        height: root.error_message != "" ? 215px : 195px;
        background: Theme.bg_surface;
        border-radius: 12px;
        border-width: 1px;
        border-color: Theme.border_active;
        clip: true;

        VerticalLayout {
            padding-top: 16px;
            padding-bottom: 16px;
            padding-left: 24px;
            padding-right: 24px;
            spacing: 12px;
            alignment: start;

            VerticalLayout {
                spacing: 4px;
                alignment: start;

                HorizontalLayout {
                    spacing: 8px;
                    alignment: start;
                    cross-axis-alignment: center;

                    Image {
                        source: @image-url("../assets/icons/folder.svg");
                        width: 20px;
                        height: 20px;
                        colorize: Theme.accent;
                    }

                    Text {
                        text: "Welcome to NoteVault";
                        font-size: 18px;
                        font-weight: 700;
                        color: Theme.text_primary;
                        vertical-alignment: center;
                    }
                }

                Text {
                    text: "Please select a directory on your system to store your encrypted notes.";
                    font-size: 12px;
                    color: Theme.text_secondary;
                    horizontal-alignment: left;
                    wrap: word-wrap;
                }
            }

            HorizontalLayout {
                spacing: 8px;

                LineEdit {
                    text: root.vault_path;
                    placeholder-text: "No vault directory selected...";
                    font-size: 13px;
                    enabled: false;
                    horizontal-stretch: 1;
                }

                Button {
                    text: "Browse...";
                    clicked => {
                        root.browse();
                    }
                }
            }

            if root.error_message != "" : Text {
                text: root.error_message;
                font-size: 12px;
                color: Theme.danger;
                horizontal-alignment: left;
            }

            HorizontalLayout {
                spacing: 10px;

                Button {
                    text: "Open Vault";
                    primary: true;
                    enabled: root.vault_path != "";
                    horizontal-stretch: 1;
                    clicked => {
                        root.open_vault(root.vault_path);
                    }
                }
            }
        }
    }
}

// ==========================================
// MODAL: EXPORT VAULT TO MARKDOWN
// ==========================================
export component ExportModal inherits Rectangle {
    x: 0px;
    y: 0px;
    width: 100%;
    height: 100%;
    background: Theme.overlay;

    in-out property <string> export_path: "";
    in property <bool> is_exporting: false;
    in property <float> export_progress: 0.0;
    in property <string> export_status: "";

    callback browse();
    callback start_export();
    callback cancel();

    TouchArea {}

    Rectangle {
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        width: 500px;
        height: root.is_exporting ? 250px : 210px;
        background: Theme.bg_surface;
        border-radius: 12px;
        border-width: 1px;
        border-color: Theme.border_active;
        clip: true;

        VerticalLayout {
            padding-top: 16px;
            padding-bottom: 16px;
            padding-left: 24px;
            padding-right: 24px;
            spacing: 12px;
            alignment: start;

            // Modal Header
            VerticalLayout {
                spacing: 4px;
                alignment: start;

                HorizontalLayout {
                    spacing: 8px;
                    alignment: start;
                    cross-axis-alignment: center;

                    Image {
                        source: @image-url("../assets/icons/file.svg");
                        width: 20px;
                        height: 20px;
                        colorize: Theme.accent;
                    }

                    Text {
                        text: "Export Vault to Markdown";
                        font-size: 18px;
                        font-weight: 700;
                        color: Theme.text_primary;
                        vertical-alignment: center;
                    }
                }

                Text {
                    text: "Decrypt all notes and save them as plain Markdown files with YAML frontmatter.";
                    font-size: 12px;
                    color: Theme.text_secondary;
                    horizontal-alignment: left;
                    wrap: word-wrap;
                }
            }

            // Danger Warning Box
            Rectangle {
                background: Theme.is_dark ? #f38ba81a : #dc354518;
                border-radius: 8px;
                border-width: 1px;
                border-color: Theme.danger;

                VerticalLayout {
                    padding-top: 8px;
                    padding-bottom: 8px;
                    padding-left: 10px;
                    padding-right: 10px;
                    alignment: start;

                    Text {
                        text: "⚠️ WARNING: Exported notes will be saved as plain text (.md) and will NO LONGER BE ENCRYPTED.";
                        font-size: 11px;
                        font-weight: 700;
                        color: Theme.danger;
                        horizontal-alignment: left;
                        wrap: word-wrap;
                    }
                }
            }

            // Export Destination Directory Row
            HorizontalLayout {
                spacing: 8px;

                LineEdit {
                    text: root.export_path;
                    placeholder-text: "No export directory selected...";
                    font-size: 13px;
                    enabled: false;
                    read-only: true;
                    horizontal-stretch: 1;
                }

                Button {
                    text: "Browse...";
                    enabled: !root.is_exporting;
                    clicked => {
                        root.browse();
                    }
                }
            }

            // Progress Indicator (Only visible while exporting)
            if root.is_exporting : VerticalLayout {
                spacing: 6px;

                HorizontalLayout {
                    Text {
                        text: root.export_status != "" ? root.export_status : "Exporting notes...";
                        font-size: 12px;
                        color: Theme.text_secondary;
                        horizontal-stretch: 1;
                        overflow: elide;
                    }

                    Text {
                        text: @tr("{0}%", Math.round(root.export_progress * 100));
                        font-size: 12px;
                        font-weight: 600;
                        color: Theme.accent;
                    }
                }

                ProgressIndicator {
                    progress: root.export_progress;
                }
            }

            // Action Buttons
            HorizontalLayout {
                spacing: 10px;

                Button {
                    text: "Cancel";
                    enabled: !root.is_exporting;
                    horizontal-stretch: 1;
                    clicked => {
                        root.cancel();
                    }
                }

                Button {
                    text: "Start Export";
                    primary: true;
                    enabled: root.export_path != "" && !root.is_exporting;
                    horizontal-stretch: 1;
                    clicked => {
                        root.start_export();
                    }
                }
            }
        }

        if !root.is_exporting : ModalCloseButton {
            x: parent.width - self.width - 12px;
            y: 12px;
            clicked => {
                root.cancel();
            }
        }
    }
}
