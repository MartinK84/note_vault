import { Button, LineEdit, TextEdit, ScrollView, ProgressIndicator, ComboBox, Palette } from "std-widgets.slint";
import { Theme, TooltipBubble } from "theme.slint";
import { 
    UnlockModal, 
    LoadingModal, 
    UnsavedWarningModal, 
    DeleteFolderModal, 
    DeleteNoteModal, 
    FolderModal, 
    RenameFolderModal, 
    MoveNoteModal, 
    AddTagModal,
    TagSuggestion,
    WelcomeModal,
    ExportModal,
    WarningModal
} from "modals.slint";
import { SettingsDialog } from "settings.slint";
import { QuickSearchWindow, QuickViewerWindow, QuickSearchResult } from "quick_search.slint";
import { UnlockWindow } from "unlock_window.slint";

export { Theme, Palette, QuickSearchWindow, QuickViewerWindow, QuickSearchResult, UnlockWindow, TagSuggestion }

export struct NoteMetadata {
    id: string,
    title: string,
    category: string,
    tags: string,
    date: string,
}

export component MainWindow inherits Window {
    title: "NoteVault - Secure Encrypted Notes";
    icon: @image-url("../assets/icons/logo.svg");
    preferred-width: 1534px;
    preferred-height: 740px;
    min-width: 960px;
    min-height: 600px;
    background: Theme.bg_main;
    default-font-family: "Segoe UI, Inter, sans-serif";

    init => {
        Palette.color-scheme = Theme.is_dark ? ColorScheme.dark : ColorScheme.light;
    }

    property <bool> is_dark: Theme.is_dark;
    changed is_dark => {
        Palette.color-scheme = Theme.is_dark ? ColorScheme.dark : ColorScheme.light;
    }

    changed is_locked => {
        if root.is_locked {
            root.show_unlock_modal = true;
        }
    }

    // --- Dynamic 3-Pane Data Models ---
    in property <[string]> folders: [];
    in-out property <string> active_folder: "*All Notes*";
    in property <[NoteMetadata]> current_notes: [];
    in property <[string]> available_categories: [];
    in property <string> vault_status_text: "Locked";

    // --- State Properties ---
    in-out property <bool> is_locked: true;
    in-out property <bool> show_unlock_modal: true;
    in-out property <bool> is_loading: false;
    in-out property <float> loading_progress: 0.0;
    in-out property <string> loading_status_text: "";
    in-out property <string> unlock_password: "";
    in-out property <string> unlock_error_message: "";
    in-out property <bool> show_keyfile_browse: false;

    // --- Unsaved Changes Tracking ---
    in-out property <bool> has_unsaved_changes: false;
    in-out property <bool> show_unsaved_warning: false;
    in-out property <string> pending_action_type: "";
    in-out property <string> pending_action_payload: "";

    // --- Search Query ---
    in-out property <string> search_query: "";

    // --- Folder Creation Modal State ---
    in-out property <bool> show_folder_modal: false;
    in-out property <string> new_folder_name: "";
    in-out property <string> folder_error_message: "";

    // --- Folder Rename Modal State ---
    in-out property <bool> show_rename_folder_modal: false;
    in-out property <string> target_folder_name: "";
    in-out property <string> rename_new_name: "";
    in-out property <string> rename_folder_error_message: "";

    // --- Warning Modal State ---
    in-out property <bool> show_warning_modal: false;
    in-out property <string> warning_modal_title: "Warning";
    in-out property <string> warning_modal_message: "";

    // --- Folder Deletion Modal State ---
    in-out property <bool> show_delete_folder_modal: false;

    // --- Note Move Modal State ---
    in-out property <bool> show_move_note_modal: false;
    in-out property <string> target_note_id: "";
    in-out property <string> target_note_title: "";
    in-out property <string> move_target_folder: "General";

    // --- Note Deletion Modal State ---
    in-out property <bool> show_delete_note_modal: false;

    // --- Add Tag Modal State ---
    in-out property <bool> show_add_tag_modal: false;
    in-out property <string> new_tag_name: "";
    in-out property <[TagSuggestion]> suggested_tags: [];
    in-out property <int> add_tag_selected_index: -1;

    // --- Active Note Metadata & Editor Content ---
    in-out property <string> active_note_id: "";
    in-out property <string> note_title: "";
    in-out property <string> note_category: "";
    in-out property <[string]> note_tags: [];
    in-out property <string> note_date: "";
    in-out property <string> note_content: "";

    // --- Note Editor Toolbar & Preferences State ---
    in-out property <bool> editor_show_line_numbers: false;
    in-out property <bool> editor_line_wrap: true;
    in-out property <bool> editor_highlight_current_line: true;
    in-out property <int> editor_font_size: 14;
    in-out property <string> line_numbers_text: "1";
    property <length> current_line_y: 0px;

    // --- Settings Modal State ---
    in-out property <bool> show_settings_modal: false;
    in-out property <string> settings_vault_path: "";
    in-out property <bool> settings_use_multithreading: true;
    in-out property <string> settings_theme: "dark";
    in property <[string]> theme_options: ["dark", "blue", "light"];
    in-out property <string> settings_global_hotkey: "Shift+Space";
    in-out property <bool> settings_minimize_to_tray: true;
    in-out property <bool> settings_launch_at_startup: false;
    in-out property <string> settings_cur_pwd: "";
    in-out property <string> settings_new_pwd: "";
    in-out property <string> settings_confirm_pwd: "";
    in property <string> password_change_status: "";
    in property <bool> password_change_success: false;
    in property <bool> is_reencrypting: false;
    in property <float> reencrypt_progress: 0.0;

    // --- Keyfile Management State ---
    in-out property <string> settings_keyfile_cur_pwd: "";
    in-out property <string> settings_new_keyfile_path: "";
    in-out property <bool> settings_remove_keyfile: false;
    in property <string> keyfile_status: "";
    in property <bool> keyfile_success: false;
    in property <bool> is_keyfile_reencrypting: false;
    in property <float> keyfile_reencrypt_progress: 0.0;

    // --- Export Vault Modal State ---
    in-out property <bool> show_export_modal: false;
    in-out property <string> export_path: "";
    in-out property <bool> is_exporting: false;
    in-out property <float> export_progress: 0.0;
    in-out property <string> export_status: "";

    // --- Welcome / Onboarding Modal State ---
    in-out property <bool> show_welcome_modal: false;
    in-out property <string> welcome_vault_path: "";
    in-out property <string> welcome_error_message: "";

    // --- Callbacks for Rust Backend ---
    callback unlock_requested(string);
    callback lock_vault();
    callback save_note_requested(string, string, string); // title, content, category
    callback select_note_requested(string); // note_id
    callback discard_changes_confirmed();
    callback rescan_vault_requested();
    callback folder_selected(string); // folder name
    callback new_note_requested();
    callback new_folder_requested();
    callback create_folder_confirmed(string); // folder_name
    callback rename_folder_confirmed(string, string); // old_name, new_name
    callback delete_folder_confirmed(string); // folder_name
    callback move_note_confirmed(string, string); // note_id, target_folder
    callback delete_note_confirmed(string); // note_id
    callback remove_tag_requested(int); // tag index
    callback open_add_tag_requested();
    callback tag_search_changed(string);
    callback add_tag_confirmed(string); // new tag
    callback search_changed(string);

    // Settings & File callbacks
    callback open_settings_requested();
    callback save_settings_requested(string, bool, string, string, bool, bool); // path, multithreading, theme, hotkey, minimize_to_tray, launch_at_startup
    callback browse_vault_path_requested();
    callback change_password_requested(string, string, string); // current, new, confirm
    callback unlock_browse_keyfile_requested();
    callback browse_new_keyfile_requested();
    callback update_keyfile_requested(string, string, bool); // current, new_path, remove
    callback welcome_open_vault_requested(string);
    callback exit_requested();
    callback theme_changed(string);
    callback record_hotkey_requested(string, bool, bool, bool, bool) -> string;

    // Export callbacks
    callback browse_export_path_requested();
    callback start_export_requested();

    // Note Editor Callbacks
    callback editor_setting_changed(string, string);
    callback export_note_json_requested();
    callback export_note_txt_requested();
    callback note_content_edited(string);

    // ==========================================
    // 3-PANE LAYOUT: FOLDERS | NOTES | EDITOR
    // ==========================================
    HorizontalLayout {
        padding: 8px;
        spacing: 8px;

        // -------------------------------------------------------------
        // PANE 1: FOLDERS LIST (Fixed ~210px)
        // -------------------------------------------------------------
        Rectangle {
            width: 210px;
            background: Theme.bg_secondary;
            border-radius: 8px;
            border-width: 1px;
            border-color: Theme.border;
            clip: true;

            VerticalLayout {
                padding: 0px;
                spacing: 0px;

                // Top Sleek Menu Bar Strip (Height 26px)
                Rectangle {
                    height: 26px;
                    background: Theme.bg_secondary;

                    Rectangle {
                        x: 0px;
                        y: parent.height - 1px;
                        width: parent.width;
                        height: 1px;
                        background: Theme.border;
                    }

                    HorizontalLayout {
                        padding-left: 8px;
                        padding-right: 8px;
                        alignment: start;

                        file_menu_btn := Rectangle {
                            width: 38px;
                            height: 20px;
                            border-radius: 4px;
                            background: file_menu_touch.has-hover ? Theme.hover : Colors.transparent;
                            y: (parent.height - self.height) / 2;

                            file_menu_touch := TouchArea {
                                mouse-cursor: pointer;
                                clicked => {
                                    file_popup.show();
                                }
                            }

                            Text {
                                text: "File";
                                font-size: 12px;
                                color: Theme.text_primary;
                                horizontal-alignment: center;
                                vertical-alignment: center;
                            }

                            file_popup := PopupWindow {
                                width: 145px;
                                height: 104px;
                                x: 0px;
                                y: 22px;

                                Rectangle {
                                    background: Theme.bg_surface;
                                    border-radius: 6px;
                                    border-width: 1px;
                                    border-color: Theme.border_active;

                                    VerticalLayout {
                                        padding: 4px;
                                        spacing: 2px;

                                        // Settings Item
                                        Rectangle {
                                            height: 30px;
                                            border-radius: 4px;
                                            background: settings_item_touch.has-hover ? Theme.hover : Colors.transparent;

                                            settings_item_touch := TouchArea {
                                                clicked => {
                                                    file_popup.close();
                                                    root.open_settings_requested();
                                                }
                                            }

                                            HorizontalLayout {
                                                padding-left: 8px;
                                                padding-right: 8px;
                                                spacing: 8px;
                                                alignment: start;
                                                cross-axis-alignment: center;

                                                Image {
                                                    source: @image-url("../assets/icons/settings.svg");
                                                    width: 14px;
                                                    height: 14px;
                                                    colorize: Theme.text_primary;
                                                }
                                                Text { text: "Settings"; font-size: 12px; color: Theme.text_primary; vertical-alignment: center; }
                                            }
                                        }

                                        // Export Vault Item
                                        Rectangle {
                                            height: 30px;
                                            border-radius: 4px;
                                            background: (!root.is_locked && export_item_touch.has-hover) ? Theme.hover : Colors.transparent;

                                            export_item_touch := TouchArea {
                                                mouse-cursor: root.is_locked ? default : pointer;
                                                clicked => {
                                                    if root.is_locked {
                                                        return;
                                                    }
                                                    file_popup.close();
                                                    root.show_export_modal = true;
                                                }
                                            }

                                            HorizontalLayout {
                                                padding-left: 8px;
                                                padding-right: 8px;
                                                spacing: 8px;
                                                alignment: start;
                                                cross-axis-alignment: center;

                                                Image {
                                                    source: @image-url("../assets/icons/file.svg");
                                                    width: 14px;
                                                    height: 14px;
                                                    colorize: root.is_locked ? Theme.text_muted : Theme.text_primary;
                                                }
                                                Text { text: "Export Vault"; font-size: 12px; color: root.is_locked ? Theme.text_muted : Theme.text_primary; vertical-alignment: center; }
                                            }
                                        }

                                        // Exit Item
                                        Rectangle {
                                            height: 30px;
                                            border-radius: 4px;
                                            background: exit_item_touch.has-hover ? Theme.hover : Colors.transparent;

                                            exit_item_touch := TouchArea {
                                                clicked => {
                                                    file_popup.close();
                                                    root.exit_requested();
                                                }
                                            }

                                            HorizontalLayout {
                                                padding-left: 8px;
                                                padding-right: 8px;
                                                spacing: 8px;
                                                alignment: start;
                                                cross-axis-alignment: center;

                                                Image {
                                                    source: @image-url("../assets/icons/x.svg");
                                                    width: 14px;
                                                    height: 14px;
                                                    colorize: Theme.danger;
                                                }
                                                Text { text: "Exit"; font-size: 12px; color: Theme.danger; vertical-alignment: center; }
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    }
                }

                // Pane 1 Header (Height 48px)
                Rectangle {
                    height: 48px;
                    vertical-stretch: 0;
                    background: Theme.bg_secondary;
                    z: 10;

                    Rectangle {
                        x: 0px;
                        y: parent.height - 1px;
                        width: parent.width;
                        height: 1px;
                        background: Theme.border;
                    }

                    HorizontalLayout {
                        padding-top: 10px;
                        padding-bottom: 10px;
                        padding-left: 14px;
                        padding-right: 14px;
                        spacing: 6px;

                        Text {
                            text: "FOLDERS";
                            font-size: 11px;
                            font-weight: 700;
                            color: Theme.text_secondary;
                            letter-spacing: 1px;
                            vertical-alignment: center;
                        }

                        Rectangle {
                            horizontal-stretch: 1;
                            background: Colors.transparent;
                        }

                        HorizontalLayout {
                            spacing: 4px;

                            Rectangle {
                                height: 26px;
                                width: 28px;
                                border-radius: 4px;
                                background: refresh_touch.has-hover ? Theme.hover : Colors.transparent;

                                refresh_touch := TouchArea {
                                    mouse-cursor: root.is_locked ? default : pointer;
                                    clicked => {
                                        if root.is_locked {
                                            return;
                                        }
                                        if root.has_unsaved_changes {
                                            root.pending_action_type = "rescan_vault";
                                            root.pending_action_payload = "";
                                            root.show_unsaved_warning = true;
                                        } else {
                                            root.rescan_vault_requested();
                                        }
                                    }
                                }

                                Image {
                                    source: @image-url("../assets/icons/refresh.svg");
                                    width: 14px;
                                    height: 14px;
                                    colorize: root.is_locked ? Theme.text_muted : Theme.text_primary;
                                    x: (parent.width - self.width) / 2;
                                    y: (parent.height - self.height) / 2;
                                }

                                TooltipBubble {
                                    text: "Refresh Vault (F5)";
                                    show: !root.is_locked && refresh_touch.has-hover;
                                    x: 0px;
                                    y: parent.height + 4px;
                                }
                            }

                            Rectangle {
                                height: 26px;
                                width: 28px;
                                border-radius: 4px;
                                background: (!root.is_locked && add_folder_touch.has-hover) ? Theme.hover : Colors.transparent;

                                add_folder_touch := TouchArea {
                                    mouse-cursor: root.is_locked ? default : pointer;
                                    clicked => {
                                        if root.is_locked {
                                            return;
                                        }
                                        if root.has_unsaved_changes {
                                            root.pending_action_type = "new_folder";
                                            root.pending_action_payload = "";
                                            root.show_unsaved_warning = true;
                                        } else {
                                            root.new_folder_name = "";
                                            root.folder_error_message = "";
                                            root.show_folder_modal = true;
                                            root.new_folder_requested();
                                        }
                                    }
                                }

                                Image {
                                    source: @image-url("../assets/icons/plus.svg");
                                    width: 14px;
                                    height: 14px;
                                    colorize: root.is_locked ? Theme.text_muted : Theme.text_primary;
                                    x: (parent.width - self.width) / 2;
                                    y: (parent.height - self.height) / 2;
                                }

                                TooltipBubble {
                                    text: "New Folder";
                                    show: !root.is_locked && add_folder_touch.has-hover;
                                    x: 0px;
                                    y: parent.height + 4px;
                                }
                            }

                            Rectangle {
                                height: 26px;
                                width: 28px;
                                border-radius: 4px;
                                background: lock_touch.has-hover ? Theme.hover : Colors.transparent;

                                lock_touch := TouchArea {
                                    mouse-cursor: pointer;
                                    clicked => {
                                        if root.is_locked {
                                            root.show_unlock_modal = true;
                                        } else {
                                            root.is_locked = true;
                                            root.show_unlock_modal = true;
                                            root.lock_vault();
                                        }
                                    }
                                }

                                Image {
                                    source: @image-url("../assets/icons/lock.svg");
                                    width: 14px;
                                    height: 14px;
                                    colorize: root.is_locked ? Theme.accent : Theme.text_primary;
                                    x: (parent.width - self.width) / 2;
                                    y: (parent.height - self.height) / 2;
                                }

                                TooltipBubble {
                                    text: root.is_locked ? "Unlock Vault" : "Lock Vault";
                                    show: lock_touch.has-hover;
                                    x: parent.width - self.width;
                                    y: parent.height + 4px;
                                }
                            }
                        }
                    }
                }

                // Folders Flat List
                if root.is_locked : Rectangle {
                    vertical-stretch: 1;
                }

                if !root.is_locked : ScrollView {
                    vertical-stretch: 1;

                    VerticalLayout {
                        padding: 8px;
                        spacing: 3px;
                        alignment: start;

                        // All Notes static global view item
                        Rectangle {
                            height: 32px;
                            border-radius: 6px;
                            background: root.active_folder == "*All Notes*" ? Theme.bg_active : (all_notes_touch.has-hover ? Theme.hover : Colors.transparent);

                            all_notes_touch := TouchArea {
                                clicked => {
                                    if root.active_folder == "*All Notes*" {
                                        return;
                                    }
                                    if root.has_unsaved_changes {
                                        root.pending_action_type = "select_folder";
                                        root.pending_action_payload = "*All Notes*";
                                        root.show_unsaved_warning = true;
                                    } else {
                                        root.active_folder = "*All Notes*";
                                        root.folder_selected("*All Notes*");
                                    }
                                }
                            }

                            HorizontalLayout {
                                padding-left: 10px;
                                padding-right: 10px;
                                spacing: 8px;
                                alignment: start;
                                cross-axis-alignment: center;

                                Image {
                                    source: @image-url("../assets/icons/layers.svg");
                                    width: 14px;
                                    height: 14px;
                                    colorize: root.active_folder == "*All Notes*" ? Theme.accent : Theme.text_primary;
                                }

                                Text {
                                    text: "All Notes";
                                    font-size: 13px;
                                    font-weight: root.active_folder == "*All Notes*" ? 600 : 400;
                                    color: root.active_folder == "*All Notes*" ? Theme.accent : Theme.text_primary;
                                    vertical-alignment: center;
                                    horizontal-stretch: 1;
                                    overflow: elide;
                                }
                            }
                        }

                        VerticalLayout {
                            padding-top: 4px;
                            padding-bottom: 4px;
                            Rectangle {
                                height: 1px;
                                background: Theme.border;
                            }
                        }

                        for folder in root.folders : Rectangle {
                            height: 32px;
                            border-radius: 6px;
                            background: root.active_folder == folder ? Theme.bg_active : (folder_touch.has-hover ? Theme.hover : Colors.transparent);

                            folder_menu := PopupWindow {
                                width: 140px;
                                height: 74px;
                                x: folder_touch.mouse-x;
                                y: folder_touch.mouse-y;

                                Rectangle {
                                    background: Theme.bg_surface;
                                    border-radius: 6px;
                                    border-width: 1px;
                                    border-color: Theme.border_active;

                                    VerticalLayout {
                                        padding: 4px;
                                        spacing: 2px;
                                        alignment: center;

                                        // Rename Folder option
                                        Rectangle {
                                            height: 30px;
                                            border-radius: 4px;
                                            background: ren_touch.has-hover ? Theme.hover : Colors.transparent;

                                            ren_touch := TouchArea {
                                                clicked => {
                                                    folder_menu.close();
                                                    root.target_folder_name = folder;
                                                    root.rename_new_name = folder;
                                                    root.rename_folder_error_message = "";
                                                    root.show_rename_folder_modal = true;
                                                }
                                            }

                                            HorizontalLayout {
                                                padding-left: 10px;
                                                padding-right: 10px;
                                                spacing: 8px;
                                                alignment: start;
                                                cross-axis-alignment: center;

                                                Image {
                                                    source: @image-url("../assets/icons/edit.svg");
                                                    width: 14px;
                                                    height: 14px;
                                                    colorize: Theme.text_primary;
                                                }
                                                Text {
                                                    text: "Rename Folder";
                                                    font-size: 12px;
                                                    color: Theme.text_primary;
                                                    vertical-alignment: center;
                                                }
                                            }
                                        }

                                        // Delete Folder option
                                        Rectangle {
                                            height: 30px;
                                            border-radius: 4px;
                                            background: del_f_touch.has-hover ? Theme.hover : Colors.transparent;

                                            del_f_touch := TouchArea {
                                                clicked => {
                                                    folder_menu.close();
                                                    root.target_folder_name = folder;
                                                    root.show_delete_folder_modal = true;
                                                }
                                            }

                                            HorizontalLayout {
                                                padding-left: 10px;
                                                padding-right: 10px;
                                                spacing: 8px;
                                                alignment: start;
                                                cross-axis-alignment: center;

                                                Image {
                                                    source: @image-url("../assets/icons/trash.svg");
                                                    width: 14px;
                                                    height: 14px;
                                                    colorize: Theme.danger;
                                                }
                                                Text {
                                                    text: "Delete Folder";
                                                    font-size: 12px;
                                                    color: Theme.danger;
                                                    vertical-alignment: center;
                                                }
                                            }
                                        }
                                    }
                                }
                            }

                            folder_touch := TouchArea {
                                clicked => {
                                    if root.active_folder == folder {
                                        return;
                                    }
                                    if root.has_unsaved_changes {
                                        root.pending_action_type = "select_folder";
                                        root.pending_action_payload = folder;
                                        root.show_unsaved_warning = true;
                                    } else {
                                        root.active_folder = folder;
                                        root.folder_selected(folder);
                                    }
                                }
                                pointer-event(event) => {
                                    if event.button == PointerEventButton.right {
                                        folder_menu.show();
                                    }
                                }
                            }

                            HorizontalLayout {
                                padding-left: 10px;
                                padding-right: 10px;
                                spacing: 8px;
                                alignment: start;
                                cross-axis-alignment: center;

                                Image {
                                    source: @image-url("../assets/icons/folder.svg");
                                    width: 14px;
                                    height: 14px;
                                    colorize: root.active_folder == folder ? Theme.accent : Theme.text_secondary;
                                }

                                Text {
                                    text: folder;
                                    font-size: 13px;
                                    font-weight: root.active_folder == folder ? 600 : 400;
                                    color: root.active_folder == folder ? Theme.accent : Theme.text_primary;
                                    vertical-alignment: center;
                                    horizontal-stretch: 1;
                                    overflow: elide;
                                }
                            }
                        }
                    }
                }

                // Pane 1 Footer Status & Settings Access
                Rectangle {
                    height: 32px;
                    background: Theme.bg_secondary;

                    Rectangle {
                        x: 0px;
                        y: 0px;
                        width: parent.width;
                        height: 1px;
                        background: Theme.border;
                    }

                    HorizontalLayout {
                        padding-left: 12px;
                        padding-right: 12px;
                        spacing: 6px;
                        alignment: center;

                        Rectangle {
                            width: 7px;
                            height: 7px;
                            border-radius: 3px;
                            background: root.is_locked ? Theme.danger : Theme.success;
                            y: (parent.height - self.height) / 2;
                        }

                        Text {
                            text: root.vault_status_text;
                            font-size: 10px;
                            color: Theme.text_secondary;
                            overflow: elide;
                            horizontal-stretch: 1;
                            vertical-alignment: center;
                        }
                    }

                    if root.is_locked : TouchArea {
                        mouse-cursor: pointer;
                        clicked => {
                            root.show_unlock_modal = true;
                        }
                    }
                }
            }
        }

        // -------------------------------------------------------------
        // PANE 2: NOTES LIST (Fixed ~300px)
        // -------------------------------------------------------------
        Rectangle {
            width: 300px;
            background: Theme.bg_surface;
            border-radius: 8px;
            border-width: 1px;
            border-color: Theme.border;
            clip: true;

            VerticalLayout {
                padding: 0px;
                spacing: 0px;

                // Pane 2 Header (Height 52px, Search LineEdit + New Note Button)
                Rectangle {
                    height: 52px;
                    vertical-stretch: 0;
                    background: Theme.bg_surface;
                    z: 10;

                    Rectangle {
                        x: 0px;
                        y: parent.height - 1px;
                        width: parent.width;
                        height: 1px;
                        background: Theme.border;
                    }

                    HorizontalLayout {
                        padding-top: 12px;
                        padding-bottom: 12px;
                        padding-left: 16px;
                        padding-right: 16px;
                        spacing: 8px;

                        LineEdit {
                            height: 28px;
                            font-size: 13px;
                            text <=> root.search_query;
                            placeholder-text: "Search notes...";
                            enabled: !root.is_locked;
                            horizontal-stretch: 1;
                            edited(val) => {
                                root.search_changed(val);
                            }
                        }

                        if !root.is_locked && root.active_folder != "*All Notes*" : Rectangle {
                            height: 28px;
                            width: 32px;
                            border-radius: 4px;
                            background: new_note_touch.has-hover ? Theme.hover : Colors.transparent;

                            new_note_touch := TouchArea {
                                mouse-cursor: pointer;
                                clicked => {
                                    if root.has_unsaved_changes {
                                        root.pending_action_type = "new_note";
                                        root.pending_action_payload = "";
                                        root.show_unsaved_warning = true;
                                    } else {
                                        root.new_note_requested();
                                    }
                                }
                            }

                            Image {
                                source: @image-url("../assets/icons/plus.svg");
                                width: 14px;
                                height: 14px;
                                colorize: Theme.text_primary;
                                x: (parent.width - self.width) / 2;
                                y: (parent.height - self.height) / 2;
                            }

                            TooltipBubble {
                                text: "New Note";
                                show: !root.is_locked && new_note_touch.has-hover;
                                x: parent.width - self.width;
                                y: parent.height + 4px;
                            }
                        }
                    }
                }

                // Pane 2 Notes Cards List (ScrollView)
                if root.is_locked : Rectangle {
                    vertical-stretch: 1;
                }

                if !root.is_locked : ScrollView {
                    vertical-stretch: 1;

                    VerticalLayout {
                        padding: 8px;
                        spacing: 6px;
                        alignment: start;

                        for note in root.current_notes : Rectangle {
                            height: 60px;
                            border-radius: 6px;
                            background: root.active_note_id == note.id ? Theme.bg_active : (card_touch.has-hover ? Theme.hover : Theme.bg_secondary);
                            border-width: root.active_note_id == note.id ? 1px : 0px;
                            border-color: Theme.border_active;

                            note_menu := PopupWindow {
                                width: 140px;
                                height: 74px;
                                x: card_touch.mouse-x;
                                y: card_touch.mouse-y;

                                Rectangle {
                                    background: Theme.bg_surface;
                                    border-radius: 6px;
                                    border-width: 1px;
                                    border-color: Theme.border_active;

                                    VerticalLayout {
                                        padding: 4px;
                                        spacing: 2px;
                                        alignment: center;

                                        // Move Note option
                                        Rectangle {
                                            height: 30px;
                                            border-radius: 4px;
                                            background: move_touch.has-hover ? Theme.hover : Colors.transparent;

                                            move_touch := TouchArea {
                                                clicked => {
                                                    note_menu.close();
                                                    root.target_note_id = note.id;
                                                    root.target_note_title = note.title != "" ? note.title : "Untitled";
                                                    root.move_target_folder = root.active_folder != "" ? root.active_folder : "General";
                                                    root.show_move_note_modal = true;
                                                }
                                            }

                                            HorizontalLayout {
                                                padding-left: 10px;
                                                padding-right: 10px;
                                                spacing: 8px;
                                                alignment: start;
                                                cross-axis-alignment: center;

                                                Image {
                                                    source: @image-url("../assets/icons/folder.svg");
                                                    width: 14px;
                                                    height: 14px;
                                                    colorize: Theme.text_primary;
                                                }
                                                Text {
                                                    text: "Move Note";
                                                    font-size: 12px;
                                                    color: Theme.text_primary;
                                                    vertical-alignment: center;
                                                }
                                            }
                                        }

                                        // Delete Note option
                                        Rectangle {
                                            height: 30px;
                                            border-radius: 4px;
                                            background: del_touch.has-hover ? Theme.hover : Colors.transparent;

                                            del_touch := TouchArea {
                                                clicked => {
                                                    note_menu.close();
                                                    root.target_note_id = note.id;
                                                    root.target_note_title = note.title != "" ? note.title : "Untitled";
                                                    root.show_delete_note_modal = true;
                                                }
                                            }

                                            HorizontalLayout {
                                                padding-left: 10px;
                                                padding-right: 10px;
                                                spacing: 8px;
                                                alignment: start;
                                                cross-axis-alignment: center;

                                                Image {
                                                    source: @image-url("../assets/icons/trash.svg");
                                                    width: 14px;
                                                    height: 14px;
                                                    colorize: Theme.danger;
                                                }
                                                Text {
                                                    text: "Delete Note";
                                                    font-size: 12px;
                                                    color: Theme.danger;
                                                    vertical-alignment: center;
                                                }
                                            }
                                        }
                                    }
                                }
                            }

                            card_touch := TouchArea {
                                clicked => {
                                    if root.active_note_id == note.id {
                                        return;
                                    }
                                    if root.has_unsaved_changes {
                                        root.pending_action_type = "select_note";
                                        root.pending_action_payload = note.id;
                                        root.show_unsaved_warning = true;
                                    } else {
                                        root.select_note_requested(note.id);
                                    }
                                }
                                pointer-event(event) => {
                                    if event.button == PointerEventButton.right {
                                        note_menu.show();
                                    }
                                }
                            }

                            VerticalLayout {
                                padding-left: 12px;
                                padding-right: 12px;
                                padding-top: 8px;
                                padding-bottom: 8px;
                                spacing: 4px;
                                alignment: center;

                                Text {
                                    text: note.title != "" ? note.title : "Untitled";
                                    font-size: 13px;
                                    font-weight: 600;
                                    color: root.active_note_id == note.id ? Theme.accent : Theme.text_primary;
                                    overflow: elide;
                                }

                                HorizontalLayout {
                                    alignment: start;
                                    spacing: 6px;
                                    cross-axis-alignment: center;

                                    Image {
                                        source: @image-url("../assets/icons/tag.svg");
                                        width: 11px;
                                        height: 11px;
                                        colorize: Theme.text_secondary;
                                    }

                                    Text {
                                        text: note.tags != "" ? note.tags : "No tags";
                                        font-size: 11px;
                                        color: Theme.text_secondary;
                                        overflow: elide;
                                        horizontal-stretch: 1;
                                        vertical-alignment: center;
                                    }

                                    Text {
                                        text: note.date;
                                        font-size: 10px;
                                        color: Theme.text_secondary;
                                        horizontal-alignment: right;
                                        vertical-alignment: center;
                                    }
                                }
                            }
                        }

                        if root.current_notes.length == 0 : VerticalLayout {
                            padding-top: 40px;
                            alignment: center;
                            spacing: 6px;

                            Text {
                                text: root.search_query != "" ? "No matching notes" : "No notes in this folder";
                                font-size: 12px;
                                color: Theme.text_secondary;
                                horizontal-alignment: center;
                            }
                        }
                    }
                }
            }
        }

        // -------------------------------------------------------------
        // PANE 3: EDITOR (Flexible Width)
        // -------------------------------------------------------------
        Rectangle {
            horizontal-stretch: 1;
            background: Theme.bg_main;
            border-radius: 8px;
            border-width: 1px;
            border-color: Theme.border;
            clip: true;

            if !root.is_locked && root.active_note_id != "" : VerticalLayout {
                x: 0px;
                y: 0px;
                width: parent.width;
                height: parent.height;
                padding: 0px;
                spacing: 0px;

                    // Single-line Metadata Header Bar (Height 52px)
                    Rectangle {
                        height: 52px;
                        vertical-stretch: 0;
                        background: Theme.bg_surface;
                        z: 20;

                        Rectangle {
                            x: 0px;
                            y: parent.height - 1px;
                            width: parent.width;
                            height: 1px;
                            background: Theme.border;
                        }

                        HorizontalLayout {
                            padding-top: 12px;
                            padding-bottom: 12px;
                            padding-left: 16px;
                            padding-right: 16px;
                            spacing: 10px;
                            vertical-stretch: 0;
                            cross-axis-alignment: center;

                            LineEdit {
                                height: 28px;
                                font-size: 13px;
                                text <=> root.note_title;
                                placeholder-text: "Note Title...";
                                width: 250px;
                                edited => {
                                    root.has_unsaved_changes = true;
                                }
                            }

                            // Interactive Tag Chips
                            HorizontalLayout {
                                spacing: 6px;
                                alignment: center;

                                for tag[idx] in root.note_tags : Rectangle {
                                    height: 24px;
                                    border-radius: 4px;
                                    background: Theme.bg_active;

                                    HorizontalLayout {
                                        padding-left: 8px;
                                        padding-right: 6px;
                                        spacing: 4px;
                                        alignment: center;
                                        cross-axis-alignment: center;

                                        Text {
                                            text: tag;
                                            font-size: 11px;
                                            font-weight: 500;
                                            color: Theme.text_primary;
                                            vertical-alignment: center;
                                        }

                                        Rectangle {
                                            width: 14px;
                                            height: 14px;
                                            border-radius: 3px;
                                            background: tag_del_touch.has-hover ? Theme.hover : Colors.transparent;

                                            tag_del_touch := TouchArea {
                                                mouse-cursor: pointer;
                                                clicked => {
                                                    root.has_unsaved_changes = true;
                                                    root.remove_tag_requested(idx);
                                                }
                                            }

                                            Image {
                                                source: @image-url("../assets/icons/x.svg");
                                                width: 8px;
                                                height: 8px;
                                                colorize: tag_del_touch.has-hover ? Theme.text_primary : Theme.text_secondary;
                                                x: (parent.width - self.width) / 2;
                                                y: (parent.height - self.height) / 2;
                                            }

                                            TooltipBubble {
                                                text: "Remove Tag";
                                                show: tag_del_touch.has-hover;
                                                x: (parent.width - self.width) / 2;
                                                y: parent.height + 4px;
                                            }
                                        }
                                    }
                                }

                                Rectangle {
                                    height: 24px;
                                    border-radius: 4px;
                                    background: add_tag_touch.has-hover ? Theme.hover : Colors.transparent;

                                    add_tag_touch := TouchArea {
                                        mouse-cursor: pointer;
                                        clicked => {
                                            root.open_add_tag_requested();
                                        }
                                    }

                                    HorizontalLayout {
                                        padding-left: 6px;
                                        padding-right: 6px;
                                        spacing: 4px;
                                        alignment: center;
                                        cross-axis-alignment: center;

                                        Image {
                                            source: @image-url("../assets/icons/plus.svg");
                                            width: 11px;
                                            height: 11px;
                                            colorize: Theme.text_primary;
                                        }

                                        Text {
                                            text: "Tag";
                                            font-size: 11px;
                                            font-weight: 500;
                                            color: Theme.text_primary;
                                            vertical-alignment: center;
                                        }
                                    }

                                    TooltipBubble {
                                        text: "Add Tag";
                                        show: add_tag_touch.has-hover;
                                        x: 0px;
                                        y: parent.height + 4px;
                                    }
                                }
                            }

                            Rectangle {
                                horizontal-stretch: 1;
                                background: Colors.transparent;
                            }

                            HorizontalLayout {
                                spacing: 5px;
                                alignment: center;
                                cross-axis-alignment: center;

                                Image {
                                    source: @image-url("../assets/icons/calendar.svg");
                                    width: 12px;
                                    height: 12px;
                                    colorize: Theme.text_secondary;
                                }

                                Text {
                                    text: root.note_date != "" ? root.note_date : "No date";
                                    font-size: 11px;
                                    color: Theme.text_secondary;
                                    vertical-alignment: center;
                                }
                            }

                            save_btn := Rectangle {
                                height: 28px;
                                border-radius: 6px;
                                background: root.has_unsaved_changes
                                    ? (save_touch.has-hover ? Theme.danger_hover : Theme.danger)
                                    : (save_touch.has-hover ? Theme.hover : Theme.bg_active);
                                animate background { duration: 150ms; }

                                save_touch := TouchArea {
                                    mouse-cursor: pointer;
                                    clicked => {
                                        root.save_note_requested(
                                            root.note_title,
                                            root.note_content,
                                            root.note_category
                                        );
                                    }
                                }

                                HorizontalLayout {
                                    padding-left: 12px;
                                    padding-right: 12px;
                                    spacing: 6px;
                                    alignment: center;
                                    cross-axis-alignment: center;

                                    Image {
                                        source: @image-url("../assets/icons/save.svg");
                                        width: 13px;
                                        height: 13px;
                                        colorize: root.has_unsaved_changes ? Theme.danger_text : Theme.text_secondary;
                                    }

                                    Text {
                                        text: "Save";
                                        font-size: 13px;
                                        font-weight: 600;
                                        color: root.has_unsaved_changes ? Theme.danger_text : Theme.text_secondary;
                                        vertical-alignment: center;
                                    }
                                }

                                TooltipBubble {
                                    text: "Save Note (Ctrl+S)";
                                    show: save_touch.has-hover;
                                    x: parent.width - self.width;
                                    y: parent.height + 4px;
                                }
                            }
                        }
                    }

                    // Note Editor Toolbar (Height 36px)
                    Rectangle {
                        height: 36px;
                        background: Theme.bg_surface;
                        z: 10;

                        // Bottom border
                        Rectangle {
                            x: 0px;
                            y: parent.height - 1px;
                            width: parent.width;
                            height: 1px;
                            background: Theme.border;
                        }

                        HorizontalLayout {
                            padding-left: 14px;
                            padding-right: 14px;
                            spacing: 6px;
                            alignment: start;
                            cross-axis-alignment: center;

                            // 1. Toggle Line Numbers Button
                            line_numbers_btn := Rectangle {
                                width: 28px;
                                height: 28px;
                                border-radius: 5px;
                                background: root.editor_show_line_numbers
                                    ? (ln_touch.has-hover ? Theme.accent_hover : Theme.bg_active)
                                    : (ln_touch.has-hover ? Theme.hover : Colors.transparent);
                                border-width: root.editor_show_line_numbers ? 1px : 0px;
                                border-color: root.editor_show_line_numbers ? Theme.accent : Colors.transparent;
                                animate background { duration: 120ms; }

                                ln_touch := TouchArea {
                                    mouse-cursor: pointer;
                                    clicked => {
                                        root.editor_show_line_numbers = !root.editor_show_line_numbers;
                                        root.editor_setting_changed("line_numbers", root.editor_show_line_numbers ? "true" : "false");
                                    }
                                }

                                Image {
                                    source: @image-url("../assets/icons/list-ordered.svg");
                                    width: 14px;
                                    height: 14px;
                                    colorize: root.editor_show_line_numbers ? Theme.accent : (ln_touch.has-hover ? Theme.text_primary : Theme.text_secondary);
                                    x: (parent.width - self.width) / 2;
                                    y: (parent.height - self.height) / 2;
                                }

                                TooltipBubble {
                                    text: "Toggle Line Numbers";
                                    show: ln_touch.has-hover;
                                    x: 0px;
                                    y: parent.height + 4px;
                                }
                            }

                            // 2. Toggle Line Wrap Button
                            wrap_btn := Rectangle {
                                width: 28px;
                                height: 28px;
                                border-radius: 5px;
                                background: root.editor_line_wrap
                                    ? (wrap_touch.has-hover ? Theme.accent_hover : Theme.bg_active)
                                    : (wrap_touch.has-hover ? Theme.hover : Colors.transparent);
                                border-width: root.editor_line_wrap ? 1px : 0px;
                                border-color: root.editor_line_wrap ? Theme.accent : Colors.transparent;
                                animate background { duration: 120ms; }

                                wrap_touch := TouchArea {
                                    mouse-cursor: pointer;
                                    clicked => {
                                        root.editor_line_wrap = !root.editor_line_wrap;
                                        if root.editor_line_wrap {
                                            editor_scroll.content-x = 0px;
                                        }
                                        root.editor_setting_changed("line_wrap", root.editor_line_wrap ? "true" : "false");
                                    }
                                }

                                Image {
                                    source: @image-url("../assets/icons/wrap-text.svg");
                                    width: 14px;
                                    height: 14px;
                                    colorize: root.editor_line_wrap ? Theme.accent : (wrap_touch.has-hover ? Theme.text_primary : Theme.text_secondary);
                                    x: (parent.width - self.width) / 2;
                                    y: (parent.height - self.height) / 2;
                                }

                                TooltipBubble {
                                    text: "Toggle Line Wrap";
                                    show: wrap_touch.has-hover;
                                    x: (parent.width - self.width) / 2;
                                    y: parent.height + 4px;
                                }
                            }

                            // 3. Toggle Current Line Highlight Button
                            hl_btn := Rectangle {
                                width: 28px;
                                height: 28px;
                                border-radius: 5px;
                                background: root.editor_highlight_current_line
                                    ? (hl_touch.has-hover ? Theme.accent_hover : Theme.bg_active)
                                    : (hl_touch.has-hover ? Theme.hover : Colors.transparent);
                                border-width: root.editor_highlight_current_line ? 1px : 0px;
                                border-color: root.editor_highlight_current_line ? Theme.accent : Colors.transparent;
                                animate background { duration: 120ms; }

                                hl_touch := TouchArea {
                                    mouse-cursor: pointer;
                                    clicked => {
                                        root.editor_highlight_current_line = !root.editor_highlight_current_line;
                                        root.editor_setting_changed("highlight_line", root.editor_highlight_current_line ? "true" : "false");
                                    }
                                }

                                Image {
                                    source: @image-url("../assets/icons/highlighter.svg");
                                    width: 14px;
                                    height: 14px;
                                    colorize: root.editor_highlight_current_line ? Theme.accent : (hl_touch.has-hover ? Theme.text_primary : Theme.text_secondary);
                                    x: (parent.width - self.width) / 2;
                                    y: (parent.height - self.height) / 2;
                                }

                                TooltipBubble {
                                    text: "Highlight Current Line";
                                    show: hl_touch.has-hover;
                                    x: (parent.width - self.width) / 2;
                                    y: parent.height + 4px;
                                }
                            }

                            // Separator
                            Rectangle {
                                width: 1px;
                                height: 18px;
                                background: Theme.border;
                            }

                            // 4. Font Size Controls (- [size] +)
                            HorizontalLayout {
                                spacing: 4px;
                                alignment: center;
                                cross-axis-alignment: center;

                                font_dec_btn := Rectangle {
                                    width: 24px;
                                    height: 24px;
                                    border-radius: 4px;
                                    background: fdec_touch.has-hover ? Theme.hover : Colors.transparent;
                                    animate background { duration: 120ms; }

                                    fdec_touch := TouchArea {
                                        mouse-cursor: pointer;
                                        clicked => {
                                            if root.editor_font_size > 10 {
                                                root.editor_font_size -= 1;
                                                root.editor_setting_changed("font_size", root.editor_font_size);
                                            }
                                        }
                                    }

                                    Image {
                                        source: @image-url("../assets/icons/minus.svg");
                                        width: 12px;
                                        height: 12px;
                                        colorize: fdec_touch.has-hover ? Theme.text_primary : Theme.text_secondary;
                                        x: (parent.width - self.width) / 2;
                                        y: (parent.height - self.height) / 2;
                                    }

                                    TooltipBubble {
                                        text: "Decrease Font Size";
                                        show: fdec_touch.has-hover;
                                        x: (parent.width - self.width) / 2;
                                        y: parent.height + 4px;
                                    }
                                }

                                Rectangle {
                                    width: 38px;
                                    height: 22px;
                                    border-radius: 4px;
                                    background: Theme.bg_secondary;

                                    Text {
                                        text: root.editor_font_size + "px";
                                        font-size: 11px;
                                        font-weight: 600;
                                        color: Theme.text_primary;
                                        horizontal-alignment: center;
                                        vertical-alignment: center;
                                    }
                                }

                                font_inc_btn := Rectangle {
                                    width: 24px;
                                    height: 24px;
                                    border-radius: 4px;
                                    background: finc_touch.has-hover ? Theme.hover : Colors.transparent;
                                    animate background { duration: 120ms; }

                                    finc_touch := TouchArea {
                                        mouse-cursor: pointer;
                                        clicked => {
                                            if root.editor_font_size < 28 {
                                                root.editor_font_size += 1;
                                                root.editor_setting_changed("font_size", root.editor_font_size);
                                            }
                                        }
                                    }

                                    Image {
                                        source: @image-url("../assets/icons/plus.svg");
                                        width: 12px;
                                        height: 12px;
                                        colorize: finc_touch.has-hover ? Theme.text_primary : Theme.text_secondary;
                                        x: (parent.width - self.width) / 2;
                                        y: (parent.height - self.height) / 2;
                                    }

                                    TooltipBubble {
                                        text: "Increase Font Size";
                                        show: finc_touch.has-hover;
                                        x: (parent.width - self.width) / 2;
                                        y: parent.height + 4px;
                                    }
                                }
                            }

                            // Horizontal Spacer pushing export buttons to the right
                            Rectangle {
                                horizontal-stretch: 1;
                                background: Colors.transparent;
                            }

                            // 5. Export Decrypted Note as JSON
                            export_json_btn := Rectangle {
                                height: 26px;
                                border-radius: 5px;
                                background: json_touch.has-hover ? Theme.hover : Theme.bg_secondary;
                                border-width: 1px;
                                border-color: json_touch.has-hover ? Theme.border_active : Theme.border;
                                animate background { duration: 120ms; }

                                json_touch := TouchArea {
                                    mouse-cursor: pointer;
                                    clicked => {
                                        root.export_note_json_requested();
                                    }
                                }

                                HorizontalLayout {
                                    padding-left: 8px;
                                    padding-right: 10px;
                                    spacing: 5px;
                                    alignment: center;
                                    cross-axis-alignment: center;

                                    Image {
                                        source: @image-url("../assets/icons/file-json.svg");
                                        width: 13px;
                                        height: 13px;
                                        colorize: json_touch.has-hover ? Theme.accent : Theme.text_secondary;
                                    }

                                    Text {
                                        text: "Export JSON";
                                        font-size: 11px;
                                        font-weight: 500;
                                        color: json_touch.has-hover ? Theme.text_primary : Theme.text_secondary;
                                        vertical-alignment: center;
                                    }
                                }

                                TooltipBubble {
                                    text: "Export Note as unencrypted JSON";
                                    show: json_touch.has-hover;
                                    x: (parent.width - self.width) / 2;
                                    y: parent.height + 4px;
                                }
                            }

                            // 6. Export Decrypted Note as TXT
                            export_txt_btn := Rectangle {
                                height: 26px;
                                border-radius: 5px;
                                background: txt_touch.has-hover ? Theme.hover : Theme.bg_secondary;
                                border-width: 1px;
                                border-color: txt_touch.has-hover ? Theme.border_active : Theme.border;
                                animate background { duration: 120ms; }

                                txt_touch := TouchArea {
                                    mouse-cursor: pointer;
                                    clicked => {
                                        root.export_note_txt_requested();
                                    }
                                }

                                HorizontalLayout {
                                    padding-left: 8px;
                                    padding-right: 10px;
                                    spacing: 5px;
                                    alignment: center;
                                    cross-axis-alignment: center;

                                    Image {
                                        source: @image-url("../assets/icons/file-text.svg");
                                        width: 13px;
                                        height: 13px;
                                        colorize: txt_touch.has-hover ? Theme.accent : Theme.text_secondary;
                                    }

                                    Text {
                                        text: "Export TXT";
                                        font-size: 11px;
                                        font-weight: 500;
                                        color: txt_touch.has-hover ? Theme.text_primary : Theme.text_secondary;
                                        vertical-alignment: center;
                                    }
                                }

                                TooltipBubble {
                                    text: "Export Note as unencrypted Text / Markdown";
                                    show: txt_touch.has-hover;
                                    x: parent.width - self.width;
                                    y: parent.height + 4px;
                                }
                            }
                        }
                    }

                    // Text Editor Area
                    Rectangle {
                        vertical-stretch: 1;
                        background: Theme.bg_main;

                        HorizontalLayout {
                            padding: 0px;
                            spacing: 0px;

                            // Line Numbers Gutter
                            if root.editor_show_line_numbers : Rectangle {
                                width: 46px;
                                background: Theme.bg_surface;

                                // Gutter right separator border
                                Rectangle {
                                    x: parent.width - 1px;
                                    y: 0px;
                                    width: 1px;
                                    height: parent.height;
                                    background: Theme.border;
                                }

                                Rectangle {
                                    x: 0px;
                                    y: 0px;
                                    width: parent.width;
                                    height: parent.height;
                                    clip: true;

                                    Text {
                                        x: 0px;
                                        y: editor_scroll.content-y + 14px;
                                        width: parent.width - 10px;
                                        text: root.line_numbers_text;
                                        font-size: root.editor_font_size * 1px;
                                        font-family: "Cascadia Code, Consolas, Courier New, monospace";
                                        color: Theme.text_muted;
                                        horizontal-alignment: right;
                                    }
                                }
                            }

                            // Main Editor Scrollable Area
                            editor_scroll := ScrollView {
                                horizontal-stretch: 1;
                                content-width: root.editor_line_wrap ? self.visible-width : max(self.visible-width, editor_input.preferred-width + 28px);
                                content-height: max(self.visible-height, editor_input.preferred-height + 28px);

                                Rectangle {
                                    width: root.editor_line_wrap ? editor_scroll.visible-width : max(editor_scroll.visible-width, editor_input.preferred-width + 28px);
                                    height: max(editor_scroll.visible-height, editor_input.preferred-height + 28px);

                                    // Active Line Highlight
                                    if root.editor_highlight_current_line : Rectangle {
                                        x: 0px;
                                        y: root.current_line_y + 14px;
                                        width: parent.width;
                                        height: (root.editor_font_size * 1.35) * 1px;
                                        background: Theme.line_highlight;
                                        border-radius: 2px;
                                    }

                                    editor_input := TextInput {
                                        x: 14px;
                                        y: 14px;
                                        width: parent.width - 28px;
                                        single-line: false;
                                        wrap: root.editor_line_wrap ? TextWrap.word-wrap : TextWrap.no-wrap;
                                        color: Theme.text_primary;
                                        font-size: root.editor_font_size * 1px;
                                        font-family: "Cascadia Code, Consolas, Courier New, monospace";
                                        selection-background-color: Theme.accent;
                                        selection-foreground-color: Theme.accent_text;
                                        text <=> root.note_content;

                                        edited => {
                                            root.has_unsaved_changes = true;
                                            root.note_content_edited(self.text);
                                        }

                                        cursor-position-changed(cpos) => {
                                            root.current_line_y = cpos.y;

                                            if !root.editor_line_wrap {
                                                if (cpos.x + editor_scroll.content-x < 0px) {
                                                    editor_scroll.content-x = min(0px, max(editor_scroll.visible-width - self.width, -cpos.x));
                                                } else if (cpos.x + editor_scroll.content-x > editor_scroll.visible-width) {
                                                    editor_scroll.content-x = min(0px, max(editor_scroll.visible-width - self.width, editor_scroll.visible-width - cpos.x));
                                                }
                                            } else {
                                                editor_scroll.content-x = 0px;
                                            }

                                            if (cpos.y + editor_scroll.content-y < 0px) {
                                                editor_scroll.content-y = min(
                                                    0px,
                                                    editor_scroll.visible-height - cpos.y - (root.editor_font_size * 1.4 * 1px),
                                                    max(editor_scroll.visible-height - self.height, -cpos.y),
                                                );
                                            } else if (cpos.y + editor_scroll.content-y > editor_scroll.visible-height - (root.editor_font_size * 1.4 * 1px)) {
                                                editor_scroll.content-y = min(
                                                    0px,
                                                    max(editor_scroll.visible-height - self.height, editor_scroll.visible-height - cpos.y - (root.editor_font_size * 1.4 * 1px))
                                                );
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    }
            }

            if root.is_locked : Rectangle {
                x: 0px;
                y: 0px;
                width: parent.width;
                height: parent.height;
                background: Theme.bg_main;

                VerticalLayout {
                    x: (parent.width - self.width) / 2;
                    y: (parent.height - self.height) / 2;
                    spacing: 14px;
                    alignment: center;
                    cross-axis-alignment: center;

                    Image {
                        source: @image-url("../assets/icons/lock.svg");
                        width: 48px;
                        height: 48px;
                        colorize: Theme.accent;
                    }

                    Text {
                        text: "Vault is Locked";
                        font-size: 18px;
                        font-weight: 700;
                        color: Theme.text_primary;
                        horizontal-alignment: center;
                    }

                    Text {
                        text: "Unlock the vault to access and edit your secure notes.";
                        font-size: 13px;
                        color: Theme.text_secondary;
                        horizontal-alignment: center;
                    }

                    Button {
                        text: "Unlock Vault";
                        primary: true;
                        clicked => {
                            root.show_unlock_modal = true;
                        }
                    }
                }
            }

            if !root.is_locked && root.active_note_id == "" : Rectangle {
                x: 0px;
                y: 0px;
                width: parent.width;
                height: parent.height;
                background: Theme.bg_main;

                VerticalLayout {
                    x: (parent.width - self.width) / 2;
                    y: (parent.height - self.height) / 2;
                    spacing: 12px;
                    alignment: center;
                    cross-axis-alignment: center;

                    Image {
                        source: @image-url("../assets/icons/file.svg");
                        width: 48px;
                        height: 48px;
                        colorize: Theme.text_muted;
                    }

                    Text {
                        text: "Select a note or create a new one";
                        font-size: 15px;
                        font-weight: 600;
                        color: Theme.text_secondary;
                        horizontal-alignment: center;
                    }
                }
            }
        }
    }

    // ==========================================
    // MODALS & DIALOGS OVERLAYS
    // ==========================================
    if root.show_folder_modal : FolderModal {
        folder_name <=> root.new_folder_name;
        error_message: root.folder_error_message;
        cancel => {
            root.show_folder_modal = false;
            root.folder_error_message = "";
        }
        create(name) => {
            root.create_folder_confirmed(name);
        }
    }

    if root.show_rename_folder_modal : RenameFolderModal {
        target_folder_name: root.target_folder_name;
        new_name <=> root.rename_new_name;
        error_message: root.rename_folder_error_message;
        cancel => {
            root.show_rename_folder_modal = false;
            root.rename_folder_error_message = "";
        }
        rename(old_name, new_name) => {
            root.rename_folder_confirmed(old_name, new_name);
        }
    }

    if root.show_warning_modal : WarningModal {
        title: root.warning_modal_title;
        message: root.warning_modal_message;
        close => {
            root.show_warning_modal = false;
        }
    }

    if root.show_delete_folder_modal : DeleteFolderModal {
        folder_name: root.target_folder_name;
        cancel => { root.show_delete_folder_modal = false; }
        delete(name) => {
            root.show_delete_folder_modal = false;
            root.delete_folder_confirmed(name);
        }
    }

    if root.show_move_note_modal : MoveNoteModal {
        note_title: root.target_note_title;
        available_folders: root.available_categories;
        target_folder <=> root.move_target_folder;
        cancel => { root.show_move_note_modal = false; }
        move_note(target) => {
            root.show_move_note_modal = false;
            root.move_note_confirmed(root.target_note_id, target);
        }
    }

    if root.show_delete_note_modal : DeleteNoteModal {
        note_title: root.target_note_title;
        cancel => { root.show_delete_note_modal = false; }
        delete => {
            root.show_delete_note_modal = false;
            root.delete_note_confirmed(root.target_note_id);
        }
    }

    if root.show_add_tag_modal : AddTagModal {
        tag_name <=> root.new_tag_name;
        suggested_tags: root.suggested_tags;
        selected_index <=> root.add_tag_selected_index;
        cancel => { root.show_add_tag_modal = false; }
        tag_input_changed(query) => { root.tag_search_changed(query); }
        add(name) => {
            root.show_add_tag_modal = false;
            root.has_unsaved_changes = true;
            root.add_tag_confirmed(name);
        }
    }

    if root.show_unsaved_warning : UnsavedWarningModal {
        cancel => {
            root.show_unsaved_warning = false;
            root.pending_action_type = "";
            root.pending_action_payload = "";
        }
        discard => {
            root.discard_changes_confirmed();
        }
    }

    if root.is_locked && root.show_unlock_modal && !root.is_loading && !root.show_welcome_modal : UnlockModal {
        password <=> root.unlock_password;
        error_message: root.unlock_error_message;
        show_keyfile_browse: root.show_keyfile_browse;
        unlock(pwd) => {
            root.unlock_requested(pwd);
        }
        browse_keyfile => {
            root.unlock_browse_keyfile_requested();
        }
        close => {
            root.show_unlock_modal = false;
        }
    }

    if root.is_loading : LoadingModal {
        progress: root.loading_progress;
        status_text: root.loading_status_text;
    }

    if root.show_welcome_modal : WelcomeModal {
        vault_path <=> root.welcome_vault_path;
        error_message: root.welcome_error_message;
        browse => {
            root.browse_vault_path_requested();
        }
        open_vault(path) => {
            root.welcome_open_vault_requested(path);
        }
    }

    if root.show_settings_modal : SettingsDialog {
        is_vault_locked: root.is_locked;
        vault_path <=> root.settings_vault_path;
        use_multithreading <=> root.settings_use_multithreading;
        theme <=> root.settings_theme;
        theme_options: root.theme_options;
        global_hotkey <=> root.settings_global_hotkey;
        minimize_to_tray <=> root.settings_minimize_to_tray;
        launch_at_startup <=> root.settings_launch_at_startup;
        current_password <=> root.settings_cur_pwd;
        new_password <=> root.settings_new_pwd;
        confirm_password <=> root.settings_confirm_pwd;
        password_change_status: root.password_change_status;
        password_change_success: root.password_change_success;
        is_reencrypting: root.is_reencrypting;
        reencrypt_progress: root.reencrypt_progress;
        keyfile_current_password <=> root.settings_keyfile_cur_pwd;
        new_keyfile_path <=> root.settings_new_keyfile_path;
        remove_keyfile <=> root.settings_remove_keyfile;
        keyfile_status: root.keyfile_status;
        keyfile_success: root.keyfile_success;
        is_keyfile_reencrypting: root.is_keyfile_reencrypting;
        keyfile_reencrypt_progress: root.keyfile_reencrypt_progress;

        browse_path_clicked => {
            root.browse_vault_path_requested();
        }
        save_settings(path, multithreading, theme, hotkey, min_tray, launch_startup) => {
            root.save_settings_requested(path, multithreading, theme, hotkey, min_tray, launch_startup);
        }
        change_password(cur, new_pwd, confirm) => {
            root.change_password_requested(cur, new_pwd, confirm);
        }
        browse_new_keyfile => {
            root.browse_new_keyfile_requested();
        }
        update_keyfile(cur, new_kf, rem_kf) => {
            root.update_keyfile_requested(cur, new_kf, rem_kf);
        }
        theme_changed(theme) => {
            root.theme_changed(theme);
        }
        record_key_event(key, ctrl, alt, shift, meta) => {
            root.record_hotkey_requested(key, ctrl, alt, shift, meta)
        }
        close_clicked => {
            root.show_settings_modal = false;
        }
    }

    if root.show_export_modal : ExportModal {
        export_path <=> root.export_path;
        is_exporting: root.is_exporting;
        export_progress: root.export_progress;
        export_status: root.export_status;
        browse => {
            root.browse_export_path_requested();
        }
        start_export => {
            root.start_export_requested();
        }
        cancel => {
            root.show_export_modal = false;
        }
    }
}
